{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "git": { "deploymentEnabled": { "main": false } },
  "cleanUrls": true,
  "redirects": [
    { "source": "/syopa", "destination": "/sopa", "permanent": true },
    { "source": "/syopa/", "destination": "/sopa/", "permanent": true },
    { "source": "/jangnong", "destination": "/jangrong", "permanent": true },
    { "source": "/jangnong/", "destination": "/jangrong/", "permanent": true },
    { "source": "/yeongyangje", "destination": "/yak", "permanent": true },
    { "source": "/yeongyangje/", "destination": "/yak/", "permanent": true },
    { "source": "/hoil", "destination": "/eunbakji", "permanent": true },
    { "source": "/hoil/", "destination": "/eunbakji/", "permanent": true },
    { "source": "/leddeung", "destination": "/jeondeung", "permanent": true },
    { "source": "/leddeung/", "destination": "/jeondeung/", "permanent": true },
    { "source": "/ledjeongu", "destination": "/jeongu", "permanent": true },
    { "source": "/ledjeongu/", "destination": "/jeongu/", "permanent": true },
    { "source": "/heeodeuraieo", "destination": "/deuraigi", "permanent": true },
    { "source": "/heeodeuraieo/", "destination": "/deuraigi/", "permanent": true },
    { "source": "/boonbyeong", "destination": "/teombeulleo", "permanent": true },
    { "source": "/boonbyeong/", "destination": "/teombeulleo/", "permanent": true },
    { "source": "/mauseu", "destination": "/kibodeu", "permanent": true },
    { "source": "/mauseu/", "destination": "/kibodeu/", "permanent": true },
    { "source": "/bonaenggabang", "destination": "/bonaengbaek", "permanent": true },
    { "source": "/bonaenggabang/", "destination": "/bonaengbaek/", "permanent": true },
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml", "permanent": true }
  ]
}
