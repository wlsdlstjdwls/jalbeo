---
import { isProductionHost } from '../lib/site';

interface Props {
  title: string;
  description: string;
  jsonLd?: unknown;
  /** 상단 바에 노출하는 발행 품목 수 */
  itemCount: number;
}
const { title, description, jsonLd, itemCount } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// 정식 도메인이 아니면 색인을 막는다. robots.txt와 같은 기준 (lib/site.ts, 게이트 2 오염 방지).
const indexable = isProductionHost(Astro.site?.host ?? '');
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#f5f3ee" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:locale" content="ko_KR" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css"
    />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <div class="topbar">
      <a href="/" class="logo">잘버려</a>
      <span class="topmeta">환경부 기준 · {itemCount}개 품목 · 출처 표기</span>
    </div>

    <main><slot /></main>

    <style is:global>
      :root {
        --paper: #f5f3ee;
        --card: #fff;
        --ink: #111;
        --line: #d9d5cb;
        --hover: #ebe7dd;
        --lime: #c9f24d;
        --muted: #43413c;
        --muted-2: #3c3a35;
        --body: #2b2a26;
        --faint: #6b6862;
        --faint-2: #7d7a72;
        --ph: #8d8a82;
        --pad: clamp(14px, 4vw, 40px);
        color-scheme: light;
      }

      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font: 400 16px/1.6 "Pretendard Variable", Pretendard, system-ui, sans-serif;
        word-break: keep-all;
        overflow-wrap: break-word;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--ink); text-decoration: none; }
      input, button { font: inherit; color: inherit; }
      [hidden] { display: none !important; }
      :focus-visible { outline: 3px solid var(--ink); outline-offset: 2px; }

      /* --- 모션. 컬러블록 컨셉이라 라운드 없음 / hard shadow만 --- */
      @keyframes rise {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: none; }
      }
      .rise { animation: rise .32s cubic-bezier(.2,.7,.2,1) both; }
      .press {
        transition: transform .12s ease, box-shadow .16s ease, background .16s ease;
      }
      .hard { box-shadow: 4px 4px 0 var(--ink); }
      .hard:hover { box-shadow: 6px 6px 0 var(--ink); transform: translate(-2px,-2px); }
      .press:active { transform: translate(2px,2px); box-shadow: 0 0 0 rgba(0,0,0,0) !important; }
      @media (prefers-reduced-motion: reduce) {
        .rise { animation: none; }
        .press, .hard, .row, .row .go { transition: none; }
      }

      /* --- 상단 바 --- */
      .topbar {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px var(--pad);
        border-bottom: 2px solid var(--ink);
        background: var(--paper);
      }
      .topbar .logo { font-weight: 800; font-size: 18px; letter-spacing: -.03em; }
      .topbar .topmeta { font-size: 12.5px; font-weight: 700; }
      @media (max-width: 380px) { .topbar .topmeta { display: none; } }

      /* --- 스텝 헤더 --- */
      .stephead {
        padding: clamp(18px,3.4vw,34px) var(--pad) clamp(16px,3vw,26px);
        border-bottom: 2px solid var(--ink);
      }
      .stepbar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
      .stepno {
        font-size: 12.5px;
        font-weight: 800;
        letter-spacing: .1em;
        color: var(--faint);
      }
      .stepbar .grow { flex: 1; }
      .back {
        cursor: pointer;
        background: transparent;
        border: 2px solid var(--ink);
        padding: 6px 14px;
        font-size: 12.5px;
        font-weight: 800;
      }
      .back:hover { background: var(--lime); }
      .display {
        margin: clamp(14px,2.4vw,22px) 0 0;
        white-space: pre-line;
        font-weight: 800;
        font-size: clamp(34px,7.6vw,92px);
        line-height: .94;
        letter-spacing: -.05em;
      }
      .hint {
        margin: 12px 0 0;
        font-size: 15px;
        font-weight: 600;
        color: var(--muted);
        max-width: 56ch;
      }

      /* --- 판정 배지 --- */
      .badge {
        background: var(--bg, var(--card));
        border: 1.5px solid var(--ink);
        padding: 5px 12px;
        font-size: 13px;
        font-weight: 800;
        white-space: nowrap;
      }

      /* --- 섹션 제목(캡션형) --- */
      .caption {
        margin: 0 0 12px;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: .1em;
      }
      /* 본문 중간에서 새 섹션을 여는 캡션(수수료/근거/관련품목 등)은 상단 구분선을 더한다 */
      .caption.divider {
        padding-top: 14px;
        border-top: 2px solid var(--ink);
      }
    </style>
  </body>
</html>
