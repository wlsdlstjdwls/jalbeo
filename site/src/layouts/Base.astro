---
import { isProductionHost } from '../lib/site';
import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../lib/supabase-public';

interface Props {
  title: string;
  description: string;
  jsonLd?: unknown;
  /** 정식 도메인에서도 색인을 막을 페이지 (관리자 화면 등). */
  noindex?: boolean;
  /** 홈만 website, 나머지는 article. */
  ogType?: string;
}
const { title, description, jsonLd, noindex = false, ogType = 'article' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// 공유 카드 이미지. 절대 URL이라야 카카오톡, 트위터, 페이스북이 읽는다.
// 원본 도형은 public/favicon.svg, 굽는 건 scripts/build_brand_assets.py.
const ogImage = new URL('/og.png', Astro.site);

// 정식 도메인이 아니면 색인을 막는다. robots.txt와 같은 기준 (lib/site.ts, 게이트 2 오염 방지).
const indexable = !noindex && isProductionHost(Astro.site?.host ?? '');

// 방문자 집계. 키가 없으면 스크립트 자체를 안 내보낸다 (로컬 클론에서도 빌드가 돈다).
const trackable = Boolean(SUPABASE_URL && SUPABASE_ANON_KEY);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#f5f3ee" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:site_name" content="잘버려" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="잘버려 - 쓰레기, 어떻게 버리지" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css"
    />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <div class="topbar">
      <a href="/" class="logo">잘버려</a>
    </div>

    <main><slot /></main>

    {trackable && (
      <script is:inline define:vars={{ endpoint: `${SUPABASE_URL}/rest/v1/rpc/track_page_view`, key: SUPABASE_ANON_KEY }}>
        // 페이지뷰 1건 기록. 저장하는 건 브라우저별 무작위 UUID, 경로, 유입 호스트뿐이다.
        (function () {
          try {
            if (location.pathname.indexOf('/admin') === 0) return;
            var id = localStorage.getItem('jalbeo_vid');
            if (!id) {
              id = crypto.randomUUID();
              localStorage.setItem('jalbeo_vid', id);
            }
            var ref = '';
            if (document.referrer) {
              var host = new URL(document.referrer).host;
              if (host && host !== location.host) ref = host;
            }
            fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', apikey: key, Authorization: 'Bearer ' + key },
              body: JSON.stringify({ p_visitor_id: id, p_path: location.pathname, p_referrer_host: ref }),
              keepalive: true,
            }).catch(function () {});
          } catch (e) {
            /* 집계 실패가 페이지를 막지 않는다 */
          }
        })();
      </script>
    )}

    <footer class="foot">
      <nav class="footnav">
        <a href="/terms/">이용약관</a>
        <a href="/privacy/" class="strong">개인정보처리방침</a>
      </nav>
      <p class="copy">&copy; {new Date().getFullYear()} jalbeo. All rights reserved.</p>
    </footer>

    <style is:global>
      :root {
        --paper: #f5f3ee;
        --card: #fff;
        --ink: #111;
        --line: #d9d5cb;
        --hover: #ebe7dd;
        --lime: #c9f24d;
        --muted: #43413c;
        --muted-2: #3c3a35;
        --body: #2b2a26;
        --faint: #6b6862;
        --faint-2: #7d7a72;
        --ph: #8d8a82;
        --pad: clamp(14px, 4vw, 40px);
        color-scheme: light;
      }

      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font: 400 16px/1.6 "Pretendard Variable", Pretendard, system-ui, sans-serif;
        word-break: keep-all;
        overflow-wrap: break-word;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--ink); text-decoration: none; }
      input, button { font: inherit; color: inherit; }
      [hidden] { display: none !important; }
      :focus-visible { outline: 3px solid var(--ink); outline-offset: 2px; }

      /* --- 모션. 컬러블록 컨셉이라 라운드 없음 / hard shadow만 --- */
      @keyframes rise {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: none; }
      }
      .rise { animation: rise .32s cubic-bezier(.2,.7,.2,1) both; }
      .press {
        transition: transform .12s ease, box-shadow .16s ease, background .16s ease;
      }
      .hard { box-shadow: 4px 4px 0 var(--ink); }
      .hard:hover { box-shadow: 6px 6px 0 var(--ink); transform: translate(-2px,-2px); }
      .press:active { transform: translate(2px,2px); box-shadow: 0 0 0 rgba(0,0,0,0) !important; }
      @media (prefers-reduced-motion: reduce) {
        .rise { animation: none; }
        .press, .hard, .row, .row .go { transition: none; }
      }

      /* --- 상단 바 --- */
      .topbar {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px var(--pad);
        border-bottom: 2px solid var(--ink);
        background: var(--paper);
      }
      .topbar .logo { font-weight: 800; font-size: 18px; letter-spacing: -.03em; }

      /* --- 스텝 헤더 --- */
      .stephead {
        padding: clamp(18px,3.4vw,34px) var(--pad) clamp(16px,3vw,26px);
        border-bottom: 2px solid var(--ink);
      }
      .stepbar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
      .stepno {
        font-size: 12.5px;
        font-weight: 800;
        letter-spacing: .1em;
        color: var(--faint);
      }
      .stepbar .grow { flex: 1; }
      .back {
        cursor: pointer;
        background: transparent;
        border: 2px solid var(--ink);
        padding: 6px 14px;
        font-size: 12.5px;
        font-weight: 800;
      }
      .back:hover { background: var(--lime); }
      .display {
        margin: clamp(14px,2.4vw,22px) 0 0;
        white-space: pre-line;
        font-weight: 800;
        font-size: clamp(34px,7.6vw,92px);
        line-height: .94;
        letter-spacing: -.05em;
      }
      .hint {
        margin: 12px 0 0;
        font-size: 15px;
        font-weight: 600;
        color: var(--muted);
        max-width: 56ch;
      }

      /* --- 판정 배지 --- */
      .badge {
        background: var(--bg, var(--card));
        border: 1.5px solid var(--ink);
        padding: 5px 12px;
        font-size: 13px;
        font-weight: 800;
        white-space: nowrap;
      }

      /* --- 푸터 --- */
      .foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px 24px;
        flex-wrap: wrap;
        padding: 22px var(--pad) 30px;
        border-top: 2px solid var(--ink);
      }
      .footnav { display: flex; gap: 18px; }
      .footnav a {
        font-size: 13.5px;
        font-weight: 500;
        border-bottom: 2px solid transparent;
      }
      .footnav a:hover { border-bottom-color: var(--ink); }
      /* 개인정보처리방침만 굵게. 법정 고지라 눈에 먼저 걸려야 한다. */
      .footnav a.strong { font-weight: 800; }
      .foot .copy { margin: 0; font-size: 12.5px; font-weight: 600; color: var(--faint); }

      /* --- 섹션 제목(캡션형) --- */
      .caption {
        margin: 0 0 12px;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: .1em;
      }
      /* 본문 중간에서 새 섹션을 여는 캡션(수수료/근거/관련품목 등)은 상단 구분선을 더한다 */
      .caption.divider {
        padding-top: 14px;
        border-top: 2px solid var(--ink);
      }
    </style>
  </body>
</html>
