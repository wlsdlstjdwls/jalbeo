---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Sources from '../components/Sources.astro';
import FeeTable from '../components/FeeTable.astro';
import { items as dbItems } from '../lib/items';
import { bg } from '../lib/verdict';
import { feeFor } from '../lib/fees';
import { HOUSING_OPTIONS, HOUSING_NOTE, ctaFor } from '../lib/flow';
import { RELATED_LIMIT } from '../lib/constants';

export async function getStaticPaths() {
  const bodies = await getCollection('items');
  const byId = new Map(bodies.map((b) => [b.id, b]));

  // DB에 발행 표시가 있고 본문도 있는 품목만 페이지가 된다.
  const live = dbItems.filter((row) => byId.has(row.slug));

  return live.map((row) => ({
    params: { slug: row.slug },
    props: { row, entry: byId.get(row.slug)! },
  }));
}

const { row, entry } = Astro.props;
const meta = entry.data;
const { Content } = await render(entry);

// STEP 2에서 물어볼 갈래. 품목이 특수하면 frontmatter가 이긴다.
const options = meta.options ?? HOUSING_OPTIONS;
const note = meta.optionsNote ?? HOUSING_NOTE;
const cta = meta.cta ?? ctaFor(row.verdict);

// 헷갈리는 품목 — 지정이 없으면 같은 판정의 다른 품목으로 채운다.
const picked = meta.related
  .map((slug) => dbItems.find((x) => x.slug === slug))
  .filter((x) => x !== undefined);
const related = (picked.length > 0
  ? picked
  : dbItems.filter((x) => x.slug !== row.slug && x.verdict === row.verdict)
).slice(0, RELATED_LIMIT);

// 이 품목이 말하는 절차를 실제로 가진 가이드. 없으면 아무것도 안 붙인다.
const allGuides = await getCollection('guides');
const guideLinks = meta.relatedGuides
  .map((id) => allGuides.find((g) => g.id === id))
  .filter((g) => g !== undefined);

// 어미가 '버리는법'과 '분리수거'로 갈려 있다 (docs/07). 페이지는 하나로 두고
// 타이틀에 둘 다 태운다. 어미별로 URL을 나누면 중복 페이지가 된다.
const title = `${row.name} 버리는법, 분리수거 방법 | 잘버려`;
const description = `${row.name}은(는) ${row.verdict}. ${row.verdict_line}`;
// 별칭은 검색용이라 오타, 띄어쓰기 변형까지 수십 개다. 다 늘어놓으면 키워드 나열로
// 보인다. 앞의 몇 개만 보이고 나머지는 검색이 받는다.
const aliases = (row.aliases ?? []).slice(0, 3);

// 검색량은 우리가 우선순위를 정하는 숫자지 방문자가 볼 정보가 아니다.
const hint3 = `분리수거 방법 / 최종 확인 ${meta.updated}`;

const titleStep3 = `${row.name}\n버리는법`;
// STEP 2 캡션. h1과 달리 한 줄이라 개행을 넣지 않는다.
const askLine = `${row.name}, 어느 쪽인가요?`;

// 수수료는 대형폐기물인 품목에만 있다.
const fee = feeFor(row.slug);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${row.name} 버리는법`,
  description,
  inLanguage: 'ko',
  dateModified: meta.updated,
  isAccessibleForFree: true,
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="stephead">
    <div class="stepbar">
      <span class="stepno">2-3단계 조건과 결과</span>
      <span class="grow"></span>
      <a class="back press" href="/">← 목록</a>
    </div>

    <h1 class="display">{titleStep3}</h1>

    <p class="hint">{hint3}</p>

    {aliases.length > 0 && (
      <p class="aliases">{aliases.map((a) => `‘${a}’`).join(', ')} 로도 불립니다</p>
    )}
  </div>

  <div class="flow">
    {options.map((_, i) => (
      <input class="optin" type="radio" name="opt" id={`opt-${i}`} checked={i === 0} />
    ))}

    <section class="step2 rise" id="step2">
      <p class="ask">{askLine}</p>
      <div class="opts">
        {options.map((o, i) => (
          <label class={`opt press hard op-${i}`} for={`opt-${i}`}>
            <span class="lb">{o.label}</span>
            <span class="hn">{o.hint}</span>
          </label>
        ))}
      </div>
      <p class="note">{note}</p>
    </section>

    <section class="step3" id="step3">
      <div class="answer rise" style={`--bg:${bg(row.verdict)}`}>
        <div class="ahead">
          <span class="vbadge">{row.verdict}</span>
          <span class="pick">
            {options.map((o, i) => <span class={`pk pk-${i}`}>{o.label}</span>)}
            <span class="region">{row.region_varies ? '지자체별 차이 있음' : '전국 공통'}</span>
          </span>
        </div>

        {options.map((o, i) => (
          <div class={`ans ans-${i}`}>
            <p class="ah">{o.head}</p>
            <p class="ab">{o.body}</p>
          </div>
        ))}

        <div class="ctas">
          <a class="press hard cta-1" href={cta.href} rel="nofollow noopener">{cta.label} →</a>
          <a class="press hard cta-2" href="#sources">근거 {meta.sources.length}건</a>
        </div>
        <p class="ctabody">{cta.body}</p>
      </div>

      <div class="blocks">
        <article class="body rise"><Content /></article>

        {fee && (
          <div class="rise"><FeeTable name={row.name} stat={fee} /></div>
        )}

        {related.length > 0 && (
          <div class="related rise">
            <p class="caption divider">헷갈리는 품목</p>
            <div class="rgrid">
              {related.map((r) => (
                <a class="press hard rcard" href={`/${r.slug}/`}>
                  <span class="rn">{r.name}</span>
                  <span class="badge sm" style={`--bg:${bg(r.verdict)}`}>{r.verdict}</span>
                </a>
              ))}
            </div>
          </div>
        )}

        {guideLinks.length > 0 && (
          <div class="related rise">
            <p class="caption divider">절차는 여기</p>
            <div class="rgrid">
              {guideLinks.map((g) => (
                <a class="press hard rcard gl" href={`/guides/${g.id}/`}>
                  <span class="rn">{g.data.title}</span>
                  <span class="badge sm">가이드</span>
                </a>
              ))}
            </div>
          </div>
        )}

        <div class="rise"><Sources sources={meta.sources} updated={meta.updated} /></div>

        <a class="press reset" href="/">다른 물건 확인하기</a>
      </div>
    </section>
  </div>

  <script is:inline>
    (function () {
      // STEP 3(본문과 출처)은 절대 숨기지 않는다. 숨기면 렌더링 기반 색인에서
      // 본문이 통째로 빠진다. JS는 답 전환과 ?opt= 동기화만 맡는다.
      var radios = document.querySelectorAll('.optin');
      var step3 = document.getElementById('step3');
      var topbar = document.querySelector('.topbar');

      function pushOpt(i) {
        history.pushState({}, '', i === null ? location.pathname : '?opt=' + i);
      }

      function scrollToStep3() {
        var offset = topbar ? topbar.getBoundingClientRect().height : 0;
        var y = step3.getBoundingClientRect().top + window.scrollY - offset;
        window.scrollTo({ top: y, behavior: 'smooth' });
      }

      function applyFromUrl() {
        var opt = new URLSearchParams(location.search).get('opt');
        var i = Number(opt);
        if (opt !== null && radios[i]) radios[i].checked = true;
        else if (radios[0]) radios[0].checked = true;
      }

      for (var i = 0; i < radios.length; i++) {
        radios[i].addEventListener('change', function (e) {
          pushOpt(e.target.id.slice(4));
          scrollToStep3();
        });
      }

      window.addEventListener('popstate', applyFromUrl);
      applyFromUrl();
    })();
  </script>
</Base>

<style>
  .aliases { margin: 10px 0 0; font-size: 12.5px; font-weight: 600; color: var(--faint-2); }

  /* --- 라디오로 답을 바꾼다. JS가 없어도 두 답 사이를 오갈 수 있다 --- */
  .optin { position: absolute; opacity: 0; width: 0; height: 0; }
  .ans, .pk { display: none; }
  #opt-0:checked ~ .step3 .ans-0,
  #opt-1:checked ~ .step3 .ans-1 { display: block; }
  #opt-0:checked ~ .step3 .pk-0,
  #opt-1:checked ~ .step3 .pk-1 { display: inline; }
  #opt-0:checked ~ .step2 .op-0 .lb::after,
  #opt-1:checked ~ .step2 .op-1 .lb::after { content: ' ✓'; }
  /* 선택된 쪽은 형광 라임으로 못 알아볼 수 없게 칠한다. 판정색은
     결과 블록이 이미 쓰고 있어서, 여기서는 선택 여부만 보이면 된다. */
  #opt-0:checked ~ .step2 .op-0,
  #opt-1:checked ~ .step2 .op-1 {
    background: var(--lime);
    box-shadow: 7px 7px 0 var(--ink);
    transform: translate(-3px,-3px);
  }
  #opt-0:checked ~ .step2 .op-0 .hn,
  #opt-1:checked ~ .step2 .op-1 .hn { color: var(--ink); }
  #opt-0:focus-visible ~ .step2 .op-0,
  #opt-1:focus-visible ~ .step2 .op-1 { outline: 3px solid var(--ink); outline-offset: 4px; }

  /* --- STEP 2 조건 고르기 --- */
  .step2 { padding: clamp(18px,3vw,30px) var(--pad) clamp(26px,4vw,46px); }
  .ask {
    margin: 0 0 16px;
    font-weight: 800;
    font-size: clamp(20px,2.8vw,28px);
    letter-spacing: -.04em;
  }
  .opts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
  }
  .opt {
    cursor: pointer;
    border: 2px solid var(--ink);
    background: var(--card);
    padding: 22px 22px 24px;
    display: grid;
    gap: 8px;
    align-content: end;
    min-height: 132px;
    transition: background .16s ease, transform .16s cubic-bezier(.2,.7,.2,1), box-shadow .16s ease;
  }
  .opt .lb {
    display: block;
    font-weight: 800;
    font-size: clamp(24px, 3vw, 34px);
    letter-spacing: -.04em;
    line-height: 1.1;
  }
  .opt .hn {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
    line-height: 1.5;
  }
  .note {
    margin: 18px 0 0;
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 70ch;
  }

  /* --- STEP 3 결과 헤더 (풀블리드) --- */
  .answer {
    background: var(--bg);
    border-bottom: 2px solid var(--ink);
    padding: clamp(20px,3.4vw,38px) var(--pad);
  }
  .ahead { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .vbadge {
    background: var(--ink);
    color: #fff;
    padding: 6px 13px;
    font-size: 12.5px;
    font-weight: 800;
    letter-spacing: .08em;
  }
  .pick { font-size: 13px; font-weight: 700; }
  .region::before { content: ' / '; }
  .ah {
    margin: 14px 0 0;
    font-weight: 800;
    font-size: clamp(26px,4.6vw,52px);
    line-height: 1.06;
    letter-spacing: -.045em;
    max-width: 24ch;
  }
  .ab { margin: 14px 0 0; font-size: 16px; line-height: 1.72; max-width: 62ch; }

  .ctas { margin-top: 20px; display: flex; gap: 10px; flex-wrap: wrap; }
  .ctas a {
    border: 2px solid var(--ink);
    padding: 14px 24px;
    font-size: 15px;
    font-weight: 800;
    transition: transform .16s ease, box-shadow .16s ease;
  }
  .cta-1 { background: var(--ink); color: #fff; }
  .cta-2 { background: var(--card); }
  .ctabody {
    margin: 14px 0 0;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--muted-2);
    max-width: 62ch;
  }

  /* --- STEP 3 본문 블록 --- */
  .blocks {
    padding: clamp(18px,3vw,32px) var(--pad) 0;
    display: grid;
    gap: clamp(18px,3vw,30px);
  }

  .body :global(h2) {
    margin: clamp(18px,3vw,30px) 0 6px;
    padding-top: 14px;
    border-top: 2px solid var(--ink);
    font-weight: 800;
    font-size: clamp(23px,3.2vw,34px);
    letter-spacing: -.04em;
  }
  .body :global(h2:first-child) { margin-top: 0; }
  .body :global(h3) {
    margin: 22px 0 4px;
    font-weight: 800;
    font-size: 18px;
    letter-spacing: -.03em;
  }
  .body :global(p) {
    margin: 12px 0 0;
    font-size: 16px;
    line-height: 1.78;
    color: var(--body);
    max-width: 70ch;
  }
  .body :global(strong) { font-weight: 800; }
  .body :global(a) { box-shadow: inset 0 -2px 0 var(--lime); }

  .body :global(ul) {
    list-style: none;
    padding: 0;
    margin: 14px 0 0;
    display: grid;
    gap: 10px;
    max-width: 70ch;
  }
  .body :global(ul > li) {
    position: relative;
    padding-left: 21px;
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--body);
  }
  .body :global(ul > li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 9px;
    height: 9px;
    background: var(--ink);
  }
  .body :global(ol) {
    margin: 14px 0 0;
    padding-left: 1.3em;
    max-width: 70ch;
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--body);
  }

  .body :global(table) {
    width: 100%;
    margin: 16px 0 0;
    border: 2px solid var(--ink);
    border-collapse: collapse;
    background: var(--card);
  }
  .body :global(th), .body :global(td) {
    border-bottom: 1px solid var(--line);
    padding: 13px 15px;
    text-align: left;
    vertical-align: baseline;
    overflow-wrap: break-word;
  }
  .body :global(th) {
    font-size: 12.5px;
    font-weight: 800;
    letter-spacing: .06em;
    color: var(--faint);
    border-bottom: 2px solid var(--ink);
    text-align: center;
    white-space: nowrap;
  }
  .body :global(td) { font-size: 14.5px; line-height: 1.55; color: var(--muted); }
  .body :global(td:first-child) { font-weight: 800; font-size: 15px; color: var(--ink); }
  /* 결론에 해당하는 칸(원문에서 굵게 쓴 값)은 라임으로 잡아준다 */
  .body :global(td:last-child strong) {
    background: var(--lime);
    padding: 2px 8px;
    color: var(--ink);
  }
  .body :global(tr:last-child td) { border-bottom: 0; }
  @media (max-width: 480px) {
    .body :global(th), .body :global(td) { padding: 10px 11px; font-size: 13.5px; }
  }

  /* --- 헷갈리는 품목 --- */
  .rgrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 10px;
  }
  .rcard {
    border: 2px solid var(--ink);
    background: var(--card);
    padding: 14px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    transition: transform .16s ease, box-shadow .16s ease;
  }
  .rn { font-weight: 800; font-size: 18px; letter-spacing: -.03em; }
  .badge.sm { padding: 3px 9px; font-size: 12px; }

  .reset {
    margin-bottom: 44px;
    display: block;
    text-align: center;
    border: 2px dashed var(--ink);
    padding: 18px;
    font-size: 15px;
    font-weight: 800;
  }
  .reset:hover { background: var(--lime); }
</style>
