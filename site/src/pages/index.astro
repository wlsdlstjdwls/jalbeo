---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { items as dbItems } from '../lib/items';
import { bg, VERDICT_ORDER } from '../lib/verdict';
import { HOME_PAGE_SIZE } from '../lib/constants';
import { fuzzyKey, searchKey } from '../lib/search';
import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../lib/supabase-public';
import { dayLogs } from '../lib/updates';

// 검색어 로그용 엔드포인트. 키가 없으면 빈 문자열이 나가고, 클라이언트가
// 빈 값이면 fetch를 안 쏜다 (Base.astro의 trackable과 같은 방어).
const searchEndpoint = SUPABASE_URL && SUPABASE_ANON_KEY
  ? `${SUPABASE_URL}/rest/v1/rpc/track_search_query`
  : '';

const bodies = new Set((await getCollection('items')).map((b) => b.id));
// 절차를 묻는 검색어(폐가전무료수거, 대형폐기물스티커)는 품목 페이지가 못 받는다.
const guides = await getCollection('guides');
const live = dbItems.filter((row) => bodies.has(row.slug));

// 사이트가 멈춰 있지 않다는 것을 첫 화면에서 보인다. 날짜는 updates.ts가 갖는다.
const logs = dayLogs();
const recentNotes = logs.flatMap((d) => d.notes.map((n) => ({ date: d.date, n }))).slice(0, 3);
const recentItems = logs
  .flatMap((d) => d.items.map((s) => ({ date: d.date, row: live.find((r) => r.slug === s) })))
  .filter((x) => x.row)
  .slice(0, 8);

const counts = live.reduce<Record<string, number>>((acc, r) => {
  acc[r.verdict] = (acc[r.verdict] ?? 0) + 1;
  return acc;
}, {});

// 첫 칩은 '전체', 나머지는 판정 순서대로. 배경은 선택 표시에만 쓰고(형광 라임),
// 판정 색은 칩 앞의 작은 사각형으로 남긴다.
const chips = [
  { v: '', label: '전체', n: live.length, color: '#fff' },
  ...VERDICT_ORDER.filter((v) => counts[v]).map((v) => ({
    v, label: v, n: counts[v], color: bg(v),
  })),
];
---

<Base
  title="잘버려 — 이거 어디에 버려요?"
  description="품목별 분리배출 방법과 판정. 환경부 기준과 지자체 조례 근거를 출처와 기준일자를 함께 표시합니다."
  ogType="website"
>
  <div class="stephead">
    <div class="stepbar">
      <span class="stepno">1단계 품목 고르기</span>
      <span class="grow"></span>
      <span class="back" style="visibility:hidden" aria-hidden="true">← 이전</span>
    </div>

    <h1 class="display">이거 어디에<br />버려요?</h1>
    <p class="hint">품목 → 조건 → 배출 방법. 세 번만 누르면 답이 나옵니다.</p>

    <div class="searchbar">
      <input
        id="q"
        type="search"
        aria-label="품목 검색"
        placeholder="선풍기, 계란껍질, 자전거…"
        autocomplete="off"
      />
      <span class="count" id="count" aria-live="polite">{live.length} / {live.length}</span>
    </div>

    <div class="chips" id="chips" role="group" aria-label="판정 필터">
      {chips.map((c) => (
        <button
          type="button"
          class={`press chip${c.v === '' ? ' on' : ''}`}
          data-v={c.v}
          aria-pressed={c.v === '' ? 'true' : 'false'}
          style={`--chip:${c.color}`}
        >{c.v !== '' && <i class="sw" aria-hidden="true"></i>}{c.label} <span class="n">{c.n}</span></button>
      ))}
    </div>
  </div>

  <section class="rise listwrap">
    <p class="caption" id="listhead">많이 찾는 품목</p>

    <div class="rows" id="list">
      {live.map((row) => {
        return (
          <a
            class="row"
            href={`/${row.slug}/`}
            data-v={row.verdict}
            data-key={searchKey(row)}
            data-fz={fuzzyKey(row)}
          >
            <span class="nm">
              <span class="n">{row.name}</span>
            </span>
            <span class="ln">{row.verdict_line}</span>
            <span class="rt">
              <span class="badge" style={`--bg:${bg(row.verdict)}`}>{row.verdict}</span>
              <span class="go" aria-hidden="true">→</span>
            </span>
          </a>
        );
      })}
    </div>

    <button type="button" class="press more" id="more" hidden></button>

    <p class="empty" id="empty" hidden>찾는 품목이 아직 없습니다. 품목은 계속 추가됩니다.</p>
  </section>

  <section class="rise guidewrap">
    <p class="caption">물건이 아니라 절차가 궁금하면</p>
    <div class="gcards">
      {guides.map((g) => (
        <a class="press hard gcard" href={`/guides/${g.id}/`}>
          <span class="gt">{g.data.title}</span>
          <span class="gl">{g.data.lede}</span>
          <span class="go" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="rise newswrap">
    <p class="caption">최근 소식</p>
    <div class="news">
      <div class="nbox">
        <h2 class="nh">최근 고친 내용</h2>
        <ul class="nl">
          {recentNotes.map((x) => (
            <li><time datetime={x.date}>{x.date.slice(5).replace('-', '.')}</time> {x.n}</li>
          ))}
        </ul>
      </div>
      <div class="nbox">
        <h2 class="nh">새로 들어온 품목</h2>
        <p class="ni">
          {recentItems.map((x, i) => (
            <>{i > 0 && ', '}<a href={`/${x.row!.slug}/`}>{x.row!.name}</a></>
          ))}
        </p>
      </div>
    </div>
    <a class="nall" href="/updates/">업데이트 기록 전체 보기 →</a>
  </section>

  <script define:vars={{ PAGE: HOME_PAGE_SIZE, SEARCH_ENDPOINT: searchEndpoint, SEARCH_KEY: SUPABASE_ANON_KEY }}>
    (function () {
      var q = document.getElementById('q');
      var list = document.getElementById('list');
      var chips = document.getElementById('chips');
      var count = document.getElementById('count');
      var head = document.getElementById('listhead');
      var empty = document.getElementById('empty');
      var more = document.getElementById('more');
      var total = list.children.length;
      var filter = '';
      var lastShown = total; // apply()가 갱신 — 디바운스된 검색 로그가 참조
      var searchTimer = null;

      // 목록 전체는 서버에서 렌더한다. 페이징은 화면에 몇 개를 보일지만 정한다.
      // 검색과 필터 중에는 결과가 잘리면 안 되므로 페이징을 풀고 전부 보여준다.
      // PAGE 값의 출처는 lib/constants.ts (HOME_PAGE_SIZE) — define:vars로 주입.
      var limit = PAGE;

      // 검색어 1건 기록. hit=0(못 찾음)이 품목 확장 후보의 핵심 신호다 (docs/20).
      // 입력이 멈춘 뒤에만 쏜다 — 매 키 입력마다 보내면 소음만 쌓인다.
      function trackSearch(term, hitCount) {
        if (!SEARCH_ENDPOINT) return;
        // 봇이 검색창에 타이핑할 일은 없지만, 쏘는 쪽이 우리 스크립트라
        // 렌더러가 값을 채우면 들어온다. Base.astro와 같은 자로 거른다.
        var ua = (navigator.userAgent || '').toLowerCase();
        if (/bot|crawl|spider|slurp|headless|preview|monitor|lighthouse|yeti|daum/.test(ua)) return;
        if (navigator.webdriver) return;
        try {
          var id = localStorage.getItem('jalbeo_vid');
          if (!id) {
            id = crypto.randomUUID();
            localStorage.setItem('jalbeo_vid', id);
          }
          fetch(SEARCH_ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', apikey: SEARCH_KEY, Authorization: 'Bearer ' + SEARCH_KEY },
            body: JSON.stringify({ p_term: term, p_hit_count: hitCount, p_visitor_id: id }),
            keepalive: true,
          }).catch(function () {});
        } catch (e) {
          /* 집계 실패가 검색을 막지 않는다 */
        }
      }

      // 아래 셋은 lib/search.ts와 같은 규칙을 클라이언트에서 다시 쓴다.
      // define:vars 스크립트는 인라인이라 모듈을 import 할 수 없다.
      // search.ts의 normalize / jamo 를 고치면 여기도 같이 고친다.
      var CHO = 'ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎ';
      var JUNG = 'ㅏㅐㅑㅒㅓㅔㅕㅖㅗㅘㅙㅚㅛㅜㅝㅞㅟㅠㅡㅢㅣ';
      var JONG = ['', 'ㄱ', 'ㄲ', 'ㄳ', 'ㄴ', 'ㄵ', 'ㄶ', 'ㄷ', 'ㄹ', 'ㄺ', 'ㄻ', 'ㄼ',
                  'ㄽ', 'ㄾ', 'ㄿ', 'ㅀ', 'ㅁ', 'ㅂ', 'ㅄ', 'ㅅ', 'ㅆ', 'ㅇ', 'ㅈ',
                  'ㅊ', 'ㅋ', 'ㅌ', 'ㅍ', 'ㅎ'];

      function jamo(text) {
        var out = '';
        for (var i = 0; i < text.length; i++) {
          var at = text.charCodeAt(i) - 0xac00;
          if (at >= 0 && at <= 0xd7a3 - 0xac00) {
            out += CHO.charAt(Math.floor(at / 588));
            out += JUNG.charAt(Math.floor((at % 588) / 28));
            out += JONG[at % 28];
          } else if (text.charAt(i) !== ' ') {
            out += text.charAt(i);
          }
        }
        return out;
      }

      // 오타 허용 폭. 자모 길이에 비례해 준다 - 짧은 말에 1을 주면
      // '플스'가 아무 품목에나 걸려 '못 찾은 검색'이라는 신호가 사라진다.
      function slack(len) {
        return len >= 9 ? 2 : (len >= 5 ? 1 : 0);
      }

      // pat이 txt "어딘가에" 거리 max 이내로 들어가면 참.
      // 첫 행을 0으로 두는 것이 부분일치를 만든다 - 검색어는 대개
      // 이름의 앞토막이라(디바운스로 '냉장꼬'까지만 온다) 꼬리를 안 벌해야 한다.
      function near(pat, txt, max) {
        var m = pat.length, n = txt.length;
        if (!m || !n) return false;
        var prev = [], cur = [], i, j;
        for (j = 0; j <= n; j++) prev[j] = 0;
        for (i = 1; i <= m; i++) {
          cur[0] = i;
          var best = i;
          for (j = 1; j <= n; j++) {
            var cost = pat.charAt(i - 1) === txt.charAt(j - 1) ? 0 : 1;
            var v = prev[j - 1] + cost;
            if (prev[j] + 1 < v) v = prev[j] + 1;
            if (cur[j - 1] + 1 < v) v = cur[j - 1] + 1;
            cur[j] = v;
            if (v < best) best = v;
          }
          if (best > max) return false;   // 이 행에서 이미 벌어졌으면 더 볼 것 없다
          var swap = prev; prev = cur; cur = swap;
        }
        for (j = 0; j <= n; j++) if (prev[j] <= max) return true;
        return false;
      }

      // 질의도 키와 같은 규칙으로 눌러 준다 (lib/search.ts의 normalize).
      // '보조 배터리' -> '보조배터리', 'SOPA' -> 'sopa'.
      function apply() {
        var term = q.value.replace(/\s+/g, '').toLowerCase();
        var narrowed = !!(filter || term);
        var hits = [];
        var exact = 0;      // 부분일치로 통과한 개수 - 검색 로그에 쏘는 값
        var i, el;
        for (i = 0; i < list.children.length; i++) {
          el = list.children[i];
          hits[i] = (!filter || el.dataset.v === filter) &&
                    (!term || el.dataset.key.toLowerCase().indexOf(term) !== -1);
          if (hits[i]) exact++;
        }

        // 부분일치가 하나도 없을 때만 오타를 봐준다. 정상 검색은 건드리지 않고,
        // 로그에 쏘는 값은 exact 그대로 둔다 - 오타 구제가 hit=0을 덮으면
        // 품목 확장 후보가 안 보인다 (docs/20).
        var fuzzed = false;
        if (term && exact === 0) {
          var pat = jamo(term);
          var max = slack(pat.length);
          if (max) {
            for (i = 0; i < list.children.length; i++) {
              el = list.children[i];
              if (filter && el.dataset.v !== filter) continue;
              var toks = (el.dataset.fz || '').split(' ');
              for (var t = 0; t < toks.length; t++) {
                if (near(pat, toks[t], max)) { hits[i] = true; fuzzed = true; break; }
              }
            }
          }
        }

        var shown = 0;      // 조건을 통과한 개수
        var drawn = 0;      // 실제로 화면에 그린 개수
        for (i = 0; i < list.children.length; i++) {
          el = list.children[i];
          if (hits[i]) shown++;
          var show = hits[i] && (narrowed || shown <= limit);
          el.hidden = !show;
          if (show) drawn++;
        }
        count.textContent = shown + ' / ' + total;
        lastShown = exact;
        head.textContent = filter ? filter + ' ' + shown + '개'
          : fuzzed ? '혹시 이걸 찾으셨나요 ' + shown + '개'
          : term ? '검색 결과 ' + shown + '개'
          : '전체 품목 (많이 찾는 순)';
        empty.hidden = shown !== 0;

        var rest = shown - drawn;
        more.hidden = rest <= 0;
        if (rest > 0) more.textContent = (rest < PAGE ? rest : PAGE) + '개 더보기 (총 ' + rest + '개 남음)';
      }

      more.addEventListener('click', function () {
        limit += PAGE;
        apply();
      });

      q.addEventListener('input', function () {
        limit = PAGE;
        apply();
        clearTimeout(searchTimer);
        var term = q.value.trim();
        if (term.length < 2) return;
        searchTimer = setTimeout(function () { trackSearch(term, lastShown); }, 800);
      });
      chips.addEventListener('click', function (e) {
        var btn = e.target.closest('.chip');
        if (!btn) return;
        filter = btn.dataset.v;
        for (var i = 0; i < chips.children.length; i++) {
          var c = chips.children[i];
          var on = c.dataset.v === filter;
          c.classList.toggle('on', on);
          c.setAttribute('aria-pressed', on ? 'true' : 'false');
        }
        limit = PAGE;
        apply();
      });

      apply();
    })();
  </script>
</Base>

<style>
  /* --- 검색 바 --- */
  .searchbar {
    margin-top: clamp(16px, 2.6vw, 26px);
    display: flex;
    align-items: stretch;
    border: 2px solid var(--ink);
    background: var(--card);
  }
  .searchbar input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    outline: none;
    padding: 16px 18px;
    font-size: clamp(16px, 2vw, 20px);
    font-weight: 700;
  }
  .searchbar input::placeholder { color: var(--ph); }
  .searchbar .count {
    display: grid;
    place-items: center;
    flex: none;
    width: clamp(88px, 24vw, 104px);
    padding: 0 8px;
    border-left: 2px solid var(--ink);
    font-size: 13px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    background: var(--lime);
  }

  /* --- 판정 필터 칩 --- */
  .chips {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    margin-top: 14px;
    padding-bottom: 2px;
    scrollbar-width: none;
  }
  .chips::-webkit-scrollbar { display: none; }
  .chip {
    flex: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 2px solid var(--ink);
    padding: 8px 15px;
    font-size: 13.5px;
    font-weight: 800;
    background: var(--card);
  }
  .chip .sw {
    width: 10px;
    height: 10px;
    flex: none;
    border: 1.5px solid var(--ink);
    background: var(--chip);
  }
  .chip .n { opacity: .55; }
  /* 선택 표시는 상세 STEP2 조건 카드와 같은 형광 라임으로 통일한다. */
  .chip.on { background: var(--lime); box-shadow: 3px 3px 0 var(--ink); }

  /* --- 품목 리스트 --- */
  .listwrap { padding: clamp(18px,3vw,30px) var(--pad) clamp(24px,4vw,44px); }
  .more {
    display: block;
    width: 100%;
    margin: 16px 0 0;
    padding: 13px;
    text-align: center;
    font-size: 14px;
    font-weight: 800;
    color: var(--ink);
    border: 2px solid var(--ink);
    background: var(--card);
    cursor: pointer;
  }
  .more:hover { background: var(--lime); }
  .rows { border-top: 2px solid var(--ink); }

  .row {
    display: grid;
    grid-template-columns: minmax(0,1fr) minmax(0,1.55fr) auto;
    gap: 6px clamp(12px, 2.4vw, 24px);
    align-items: center;
    padding: 15px 8px;
    border-bottom: 1px solid var(--line);
    transition: background .14s ease;
  }
  .row:hover { background: var(--hover); }
  .row .nm {
    display: flex;
    align-items: baseline;
    gap: 9px;
    flex-wrap: wrap;
    min-width: 0;
  }
  .row .nm .n {
    font-weight: 800;
    font-size: clamp(21px, 2.5vw, 29px);
    letter-spacing: -.035em;
  }
  .row .ln { font-size: 14.5px; line-height: 1.55; color: var(--muted); }
  .row .rt {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }
  .row .go {
    font-weight: 800;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity .16s ease, transform .16s ease;
  }
  .row:hover .go, .row:focus-visible .go { opacity: 1; transform: none; }

  /* 좁은 화면에서는 요약문을 이름 아래로. 판정은 이름 옆에 붙여 둔다 */
  @media (max-width: 640px) {
    .row { grid-template-columns: minmax(0,1fr) auto; align-items: start; }
    .row .nm { grid-area: 1 / 1; }
    .row .rt { grid-area: 1 / 2; }
    .row .ln { grid-area: 2 / 1 / 3 / 3; }
    /* 터치 환경엔 호버가 없어 화살표가 항상 숨은 채 자리만 차지한다.
       그 폭 때문에 뱃지 오른쪽 여백이 이름 왼쪽 여백보다 커 보였다. */
    .row .go { display: none; }
  }

  .empty { margin: 16px 0 0; font-size: 15px; font-weight: 600; color: var(--muted); }

  /* --- 절차 가이드. 품목 목록과 성격이 달라 카드로 떼어 놓는다 --- */
  .guidewrap { padding: 0 var(--pad) clamp(30px,5vw,56px); }
  .gcards {
    margin-top: 12px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 12px;
  }
  .gcard {
    border: 2px solid var(--ink);
    background: var(--card);
    padding: 20px 20px 22px;
    display: grid;
    gap: 8px;
    align-content: start;
    transition: transform .16s ease, box-shadow .16s ease, background .16s ease;
  }
  .gcard:hover { background: var(--lime); }
  .gt { font-weight: 800; font-size: 20px; letter-spacing: -.035em; }
  .gl {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.6;
    color: var(--muted);
  }
  .gcard:hover .gl { color: var(--ink); }
  .gcard .go { font-weight: 800; }

  /* --- 최근 소식 --- */
  .newswrap { padding: 0 var(--pad) clamp(30px,5vw,56px); }
  .news {
    margin-top: 12px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 12px;
  }
  .nbox { border: 2px solid var(--ink); background: var(--card); padding: 18px 20px 20px; min-width: 0; }
