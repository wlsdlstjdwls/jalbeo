---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { items as dbItems } from '../lib/items';
import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../lib/supabase-public';

/**
 * 관리자 대시보드. 접속 현황만 본다.
 *
 * 로그인은 Supabase Auth가 한다. 비밀번호는 auth.users에 해시로만 있고,
 * 시도 제한과 세션 만료도 Supabase가 맡는다. 이 페이지는 받은 JWT를 실어
 * 통계 RPC를 부를 뿐이고, 관리자인지 아닌지는 DB가 판정한다
 * (`is_admin()`, `db/migrations/0005`).
 *
 * 페이지 자체는 정적이다. 숫자는 브라우저가 Supabase에 직접 물어 온다.
 */
const ready = Boolean(SUPABASE_URL && SUPABASE_ANON_KEY);

// 경로 이름표. 집계 테이블에는 경로만 쌓이는데, 품목 slug이 로마자라
// `/subakkkeopjil/`만 보고는 무슨 페이지인지 알 수 없다. 빌드 시점에
// slug -> 이름을 굽어서 넣는다 (런타임에 DB를 한 번 더 부르지 않는다).
const bodies = new Set((await getCollection('items')).map((b) => b.id));
const pageNames: Record<string, string> = {
  '/': '홈',
  '/terms/': '이용약관',
  '/privacy/': '개인정보처리방침',
  '/admin/': '대시보드',
};
for (const row of dbItems) {
  if (bodies.has(row.slug)) pageNames[`/${row.slug}/`] = row.name;
}
for (const g of await getCollection('guides')) {
  pageNames[`/guides/${g.id}/`] = g.data.title;
}

// 검색어 후보 판정용 어휘. 검색(lib/search.ts normalize)과 같은 규칙으로 공백을
// 지우고 소문자로 굽는다. 발행하면 빌드가 이 목록을 새로 굽으므로 이미 받은
// 검색어는 다음 배포부터 후보에서 저절로 빠진다 (판단 71).
const norm = (t: string) => t.replace(/\s+/g, '').toLowerCase();
const vocab: [string, string][] = [];
for (const row of dbItems) {
  if (!bodies.has(row.slug)) continue;
  vocab.push([norm(row.name), row.name]);
  for (const a of row.aliases ?? []) vocab.push([norm(a), row.name]);
}
---

<Base title="대시보드 — 잘버려" description="관리자 전용 접속 현황." noindex>
  <section class="stephead">
    <div class="stepbar">
      <span class="stepno">ADMIN</span>
      <a class="back" href="/">홈으로</a>
      <span class="grow"></span>
      <button type="button" class="linkbtn" id="logout" hidden>로그아웃</button>
      <span class="stepno" id="updated">불러오는 중</span>
    </div>
    <h1 class="display">대시보드</h1>
    <p class="hint" id="lede">방문자 현황을 1분마다 새로 불러옵니다.</p>
  </section>

  {!ready && (
    <section class="pad">
      <p class="empty">
        Supabase 공개 설정이 없어 숫자를 가져오지 못합니다.
        <code>site/.env.public</code>의 <code>SUPABASE_URL</code>,
        <code>SUPABASE_ANON_KEY</code>를 채우고 다시 빌드해 주세요.
      </p>
    </section>
  )}

  <section class="pad" id="gate" hidden>
    <p class="caption">로그인</p>
    <!-- novalidate: 브라우저 기본 검사가 한글 입력 상태로 친 글자나 자동완성이
         값을 아직 안 넘긴 순간을 '틀림'으로 보고 칸을 빨갛게 칠했다. 빈 칸 확인은
         스크립트가 하고 안내는 아래 문구 한 줄로만 한다.
         name 속성은 브라우저 비밀번호 저장이 계정을 알아보는 데 쓴다. -->
    <form class="loginform" id="loginform" novalidate>
      <label class="field">
        <span>이메일</span>
        <input type="email" id="email" name="email" autocomplete="username"
               inputmode="email" autocapitalize="off" spellcheck="false" />
      </label>
      <label class="field">
        <span>비밀번호</span>
        <input type="password" id="password" name="password" autocomplete="current-password" />
      </label>
      <button type="submit" class="press hard" id="submit">로그인</button>
      <p class="formmsg" id="formmsg" hidden></p>
    </form>
  </section>

  <section class="pad" id="board" hidden>
    <p class="caption">방문자</p>
    <div class="tiles">
      <div class="tile">
        <p class="tlabel"><span class="dot"></span>동시접속</p>
        <p class="tval" id="v-live">-</p>
        <p class="tsub">최근 5분</p>
      </div>
      <div class="tile">
        <p class="tlabel">오늘 방문자</p>
        <p class="tval" id="v-today">-</p>
        <p class="tsub">KST 자정 기준</p>
      </div>
      <div class="tile">
        <p class="tlabel">오늘 조회수</p>
        <p class="tval" id="v-todayviews">-</p>
        <p class="tsub">페이지뷰</p>
      </div>
      <div class="tile">
        <p class="tlabel">누적 방문자</p>
        <p class="tval" id="v-total">-</p>
        <p class="tsub" id="v-since">수집 시작 미상</p>
      </div>
      <div class="tile">
        <p class="tlabel">누적 조회수</p>
        <p class="tval" id="v-totalviews">-</p>
        <p class="tsub">페이지뷰</p>
      </div>
      <div class="tile">
        <p class="tlabel">방문당 조회</p>
        <p class="tval" id="v-per">-</p>
        <p class="tsub">누적 조회 / 누적 방문자</p>
      </div>
    </div>

    <p class="caption gap">최근 14일</p>
    <div class="chart" id="chart"></div>

    <div class="cols">
      <div>
        <p class="caption gap">인기 경로 (7일)</p>
        <ul class="rank" id="paths"></ul>
        <button type="button" class="linkbtn all" id="all-paths" hidden>전체보기</button>
      </div>
      <div>
        <p class="caption gap">유입 경로 (7일)</p>
        <ul class="rank" id="refs"></ul>
        <button type="button" class="linkbtn all" id="all-refs" hidden>전체보기</button>
      </div>
    </div>

    <div class="mhead">
      <p class="caption gap">못 찾은 검색 (90일)</p>
      <button type="button" class="press" id="miss-load">후보 불러오기</button>
    </div>
    <p class="mlede" id="miss-lede">검색창에서 결과 0건이 나온 말 중 지금도 어느 품목에도 안 걸리는 것만 보여 줍니다.</p>
    <ul class="misses" id="misses" hidden></ul>
    <button type="button" class="linkbtn all" id="miss-judged" hidden>판정한 것도 보기</button>
  </section>

  <dialog class="sheet" id="sheet">
    <div class="shead">
      <p class="caption" id="stitle">전체보기</p>
      <button type="button" class="linkbtn" id="sclose" autofocus>닫기</button>
    </div>
    <div class="sbody" id="sbody">
      <ul class="rank wide" id="srows"></ul>
      <p class="sfoot" id="sfoot">불러오는 중</p>
    </div>
  </dialog>

  <style>
    /* 동시접속 표시등. 사이트 팔레트에 없는 색이라 이 화면에서만 정의한다. */
    #board { --live: #2fa84f; }
    .stepbar a.back {
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      background: var(--lime);
    }

    .pad { padding: clamp(18px, 3vw, 30px) var(--pad) clamp(28px, 5vw, 56px); }
    /* 품목 페이지의 .caption.divider는 전체 폭 윗줄을 긋는다. 여기서는 타일과
       차트가 이미 테두리를 갖고 있어, 그 줄이 타일 밑변을 잇는 것처럼 보이고
       좌우 2단에서는 가운데가 끊긴 선으로 보였다. 줄 대신 여백으로 나눈다. */
    .caption.gap { margin-top: 26px; }
    .empty { margin: 0 0 14px; font-size: 14.5px; font-weight: 600; color: var(--muted); max-width: 60ch; }
    code { font-size: 13px; background: var(--hover); padding: 1px 5px; }

    .linkbtn {
      cursor: pointer;
      background: transparent;
      border: 0;
      padding: 0;
      font-size: 12.5px;
      font-weight: 800;
      color: var(--faint);
      border-bottom: 2px solid var(--line);
      text-decoration: none;
    }
    .linkbtn:hover { color: var(--ink); border-bottom-color: var(--ink); }

    .loginform { display: grid; gap: 12px; max-width: 340px; padding-right: 4px; }
    .field { display: grid; gap: 5px; }
    .field span { font-size: 12px; font-weight: 800; color: var(--faint); }
    .field input {
      width: 100%;
      padding: 10px 12px;
      border: 2px solid var(--ink);
      background: var(--card);
      font-weight: 600;
    }
    .loginform button {
      justify-self: start;
      cursor: pointer;
      margin-top: 2px;
      padding: 10px 24px;
      border: 2px solid var(--ink);
      background: var(--lime);
      font-weight: 800;
    }
    .loginform button[disabled] { cursor: default; background: var(--hover); }
    .formmsg { margin: 2px 0 0; font-size: 13px; font-weight: 700; }
    /* 파이어폭스는 검사에 걸린 칸에 빨간 테두리를 그린다. 검사는 스크립트가 한다. */
    .field input:invalid, .field input:user-invalid { box-shadow: none; outline-color: var(--ink); }

    .mhead { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; }
    .mhead .press {
      cursor: pointer;
      padding: 7px 14px;
      border: 2px solid var(--ink);
      background: var(--lime);
      font-size: 13px;
      font-weight: 800;
    }
    .mhead .press[disabled] { cursor: default; background: var(--hover); }
    .mlede { margin: 8px 0 0; font-size: 12.5px; font-weight: 600; color: var(--faint-2); }
    .misses { list-style: none; margin: 10px 0 0; padding: 0; font-size: 13.5px; }
    .misses :global(li) {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 4px 10px;
      padding: 9px 0;
      border-bottom: 1px solid var(--line);
    }
    .misses :global(.mt) { font-weight: 800; }
    .misses :global(.mn) { font-size: 11.5px; font-weight: 700; color: var(--faint-2); font-variant-numeric: tabular-nums; }
    .misses :global(.mh) { flex-basis: 100%; font-size: 12px; font-weight: 600; color: var(--faint); }
    .misses :global(.ma) { margin-left: auto; display: flex; gap: 10px; }
    /* 런타임에 꽂는 버튼이라 scoped .linkbtn이 안 붙는다. 같은 모양을 여기서 준다. */
    .misses :global(button) {
      cursor: pointer;
      background: transparent;
      border: 0;
      padding: 0;
      font-size: 12.5px;
      font-weight: 800;
      color: var(--faint);
      border-bottom: 2px solid var(--line);
    }
    .misses :global(button:hover) { color: var(--ink); border-bottom-color: var(--ink); }
    .misses :global(.md) { font-size: 11.5px; font-weight: 800; padding: 1px 6px; background: var(--hover); }
    .misses :global(.none) { color: var(--faint-2); font-weight: 600; border-bottom: 0; }

    .tiles {
      display: grid;
      gap: 12px;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    }
    .tile { border: 2px solid var(--ink); background: var(--card); padding: 14px 16px 16px; }
    .tlabel {
      margin: 0;
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .04em;
      color: var(--faint);
    }
    .tval {
      margin: 6px 0 0;
      font-size: clamp(26px, 4.4vw, 38px);
      font-weight: 800;
      letter-spacing: -.04em;
      line-height: 1;
    }
    .tsub { margin: 6px 0 0; font-size: 11.5px; font-weight: 600; color: var(--faint-2); }
    /* 살아 있는 숫자라는 신호다. 종이색 위에서 라임은 너무 옅어 한 단계 진한
       초록을 쓴다. 링은 심장박동처럼 퍼지고 점은 그대로 켜져 있다. */
    .dot {
      position: relative;
      width: 8px;
      height: 8px;
      background: var(--live);
      border-radius: 50%;
    }
    .dot::after {
      content: '';
      position: absolute;
      inset: -3px;
      border-radius: 50%;
      background: var(--live);
      animation: ping 1.8s cubic-bezier(0, 0, .2, 1) infinite;
    }
    @keyframes ping {
      0% { transform: scale(.6); opacity: .55; }
      100% { transform: scale(2.1); opacity: 0; }
    }
    @media (prefers-reduced-motion: reduce) { .dot::after { animation: none; opacity: .3; } }

    .chart {
      display: flex;
      align-items: flex-end;
      gap: 4px;
      height: 140px;
      border: 2px solid var(--ink);
      background: var(--card);
      padding: 10px;
    }
    /* 차트 막대와 순위 행은 런타임에 innerHTML로 꽂는다. Astro의 scoped 속성이
       안 붙으므로 :global로 열어 둔다. 바깥 선택자가 이 페이지에 묶여 있어 새지 않는다. */
    .chart :global(.bar) { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; height: 100%; }
    .chart :global(.bar i) { display: block; background: var(--lime); border: 1.5px solid var(--ink); min-height: 2px; }
    .chart :global(.bar b) {
      display: block;
      margin-top: 4px;
      font-size: 9.5px;
      font-weight: 700;
      color: var(--faint-2);
      text-align: center;
    }

    .cols { display: grid; gap: 0 28px; grid-template-columns: 1fr; }
    @media (min-width: 720px) { .cols { grid-template-columns: 1fr 1fr; } }
    /* grid item 기본 min-width:auto 때문에 안의 flex 행이 줄 폭만큼 커져
       트랙보다 넓어지고 넘쳤다(grid blowout). 0으로 눌러야 안의 overflow:hidden이 먹는다. */
    .cols > div { min-width: 0; }
    /* 순위 한 줄. 이름과 경로를 한 줄에 붙이고 밑에 가는 막대로 비율을 깐다.
       두 줄로 쌓으면 5줄짜리 카드가 10줄이 되어 훑기가 어렵다. */
    .rank { list-style: none; margin: 0; padding: 0; font-size: 13.5px; }
    .rank :global(li) { padding: 7px 0; border-bottom: 1px solid var(--line); }
    .rank.wide :global(li) { padding: 10px 0; }
    .rank :global(.rl) { display: flex; align-items: baseline; gap: 8px; }
    .rank :global(.rk) {
      flex: none;
      width: 1.6em;
      font-size: 11.5px;
      font-weight: 800;
      color: var(--faint-2);
      font-variant-numeric: tabular-nums;
    }
    /* 이름은 줄지 않고 경로만 줄어든다. 경로가 길어도 숫자가 밀리지 않는다. */
    .rank :global(.lb) { display: flex; align-items: baseline; gap: 6px; flex: 1; min-width: 0; }
    .rank :global(.nm) { flex: none; font-weight: 700; }
    .rank :global(.pt) {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: 11.5px;
      font-weight: 600;
      color: var(--faint-2);
    }
    .rank :global(.vt) { flex: none; font-weight: 800; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .rank :global(.vt i) { font-style: normal; font-size: 11.5px; font-weight: 700; color: var(--faint-2); margin-left: 1px; }
    .rank :global(.vw) {
      flex: none;
      width: 4.4em;
      text-align: right;
      font-size: 11.5px;
      font-weight: 700;
      color: var(--faint-2);
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }
    .rank :global(.rbar) { height: 4px; margin: 5px 0 0 calc(1.6em + 8px); background: var(--line); }
    .rank :global(.rbar i) { display: block; height: 100%; background: var(--lime); border-right: 1.5px solid var(--ink); }
    .rank :global(.none) {
      padding: 10px 0;
      color: var(--faint-2);
      font-weight: 600;
      border-bottom: 0;
    }
    .rank :global(.rk) {
      width: 2.4em;
      color: var(--faint-2);
      font-weight: 800;
      font-variant-numeric: tabular-nums;
    }
    .rank :global(.nm) { display: block; }
    /* 요약은 5줄만 세운다. 나머지는 시트가 받는다. */
    .linkbtn.all { margin-top: 12px; }

    /* 전체보기 시트. 좁은 화면에서는 바닥에서 올라오고, 넓은 화면에서는
       가운데 카드로 뜬다. 사이트 문법대로 라운드 없이 2px 테두리와 hard shadow. */
    .sheet {
      width: min(560px, 100%);
      max-height: 82vh;
      margin: auto auto 0;
      padding: 0;
      border: 2px solid var(--ink);
      background: var(--paper);
      color: var(--ink);
      box-shadow: 6px 6px 0 var(--ink);
      overflow: hidden;
      animation: sheetup .22s cubic-bezier(.2,.7,.2,1);
    }
    .sheet::backdrop { background: rgba(17, 17, 17, .38); }
    @keyframes sheetup { from { transform: translateY(14px); opacity: 0; } }
    @media (min-width: 720px) {
      .sheet { margin: auto; max-height: 76vh; }
    }
    @media (prefers-reduced-motion: reduce) { .sheet { animation: none; } }

    .shead {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 16px;
      border-bottom: 2px solid var(--ink);
      background: var(--paper);
    }
    .shead .caption { margin: 0; }
    /* 스크롤은 이 상자만 한다. 머리글은 붙어 있어야 어느 표인지 안 잃는다. */
    .sbody {
      max-height: calc(82vh - 52px);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 4px 16px 16px;
    }
    @media (min-width: 720px) { .sbody { max-height: calc(76vh - 52px); } }
    .sfoot {
      margin: 14px 0 0;
      font-size: 12.5px;
      font-weight: 700;
      color: var(--faint-2);
      text-align: center;
    }
  </style>

  {ready && (
    <script is:inline define:vars={{ origin: SUPABASE_URL, key: SUPABASE_ANON_KEY, pageNames, vocab }}>
      (function () {
        var REFRESH_MS = 60000;
        var TOP_N = 5;          // 요약에 세우는 줄 수
        var SHEET_PAGE = 30;    // 시트가 한 번에 받아 오는 줄 수
        var STORE = 'jalbeo_admin_session';
        var EMAIL_STORE = 'jalbeo_admin_email';
        var $ = function (id) { return document.getElementById(id); };
        var num = function (n) { return Number(n || 0).toLocaleString('ko-KR'); };
        var timer = null;

        // --- 세션 --------------------------------------------------------
        // access_token은 한 시간이면 만료된다. refresh_token으로 조용히 갱신하고
        // 그것마저 거절되면 로그인 화면으로 돌린다.
        function saveSession(s) {
          try {
            localStorage.setItem(STORE, JSON.stringify({
              access_token: s.access_token,
              refresh_token: s.refresh_token,
              expires_at: s.expires_at,
            }));
          } catch (e) {}
        }

        function loadSession() {
          try { return JSON.parse(localStorage.getItem(STORE) || 'null'); } catch (e) { return null; }
        }

        function clearSession() {
          try { localStorage.removeItem(STORE); } catch (e) {}
        }

        function auth(path, body) {
          return fetch(origin + '/auth/v1/' + path, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', apikey: key },
            body: JSON.stringify(body),
          }).then(function (res) {
            return res.json().then(function (data) {
              if (!res.ok) {
                var err = new Error(data.error_description || data.msg || String(res.status));
                err.status = res.status;
                throw err;
              }
              return data;
            });
          });
        }

        // 만료 60초 전부터 미리 갱신한다. 화면이 1분마다 도니 그 사이에 안 끊긴다.
        function validSession() {
          var s = loadSession();
          if (!s || !s.refresh_token) return Promise.reject(new Error('no-session'));
          var now = Math.floor(Date.now() / 1000);
          if (s.expires_at && s.expires_at - 60 > now) return Promise.resolve(s);
          return auth('token?grant_type=refresh_token', { refresh_token: s.refresh_token })
            .then(function (fresh) { saveSession(fresh); return fresh; });
        }

        function rpc(session, name, body) {
          return fetch(origin + '/rest/v1/rpc/' + name, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              apikey: key,
              Authorization: 'Bearer ' + session.access_token,
            },
            body: JSON.stringify(body || {}),
          }).then(function (res) {
            if (!res.ok) throw new Error('rpc-' + res.status);
            // 반환값이 없는 함수(void)는 204에 본문이 비어 온다.
            return res.text().then(function (t) { return t ? JSON.parse(t) : null; });
          });
        }

        // --- 화면 --------------------------------------------------------
        function note(text, bad) {
          var el = $('formmsg');
          el.textContent = text || '';
          el.style.color = bad ? '#b3261e' : 'var(--faint)';
          el.hidden = !text;
        }

        function showGate(message) {
          $('board').hidden = true;
          $('gate').hidden = false;
          $('logout').hidden = true;
          $('updated').textContent = '';
          $('lede').textContent = '관리자 계정으로 로그인해 주세요.';
          note(message, Boolean(message));
        }

        function drawChart(rows) {
          var max = 1;
          rows.forEach(function (r) { if (r.views > max) max = r.views; });
          $('chart').innerHTML = rows.map(function (r) {
            var h = Math.round((r.views / max) * 100);
            var d = r.day.slice(5).replace('-', '/');
            return '<span class="bar" title="' + d + ' 방문 ' + num(r.visitors) +
              ' / 조회 ' + num(r.views) + '"><i style="height:' + h + '%"></i><b>' +
              d.slice(3) + '</b></span>';
          }).join('');
        }

        function esc(s) {
          return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');
        }

        // 경로는 인코딩된 채로 쌓인다(/%EA%B1%B4...). 못 읽으면 원문을 그대로 둔다.
        function decodePath(s) {
          try { return decodeURIComponent(s); } catch (e) { return s; }
        }

        // 이름을 아는 경로는 이름을 앞에 세우고 경로를 옆에 작게 붙인다.
        // 모르는 경로(오타 링크, 지운 slug)와 유입 호스트는 그것만 보여준다.
        function label(text, named) {
          var shown = named ? decodePath(text) : text;
          var name = named && (pageNames[text] || pageNames[text.replace(/\/?$/, '/')]);
          if (!name) return '<span class="nm">' + esc(shown) + '</span>';
          return '<span class="nm">' + esc(name) + '</span>' +
                 '<span class="pt">' + esc(shown) + '</span>';
        }

        // 순위 한 줄. 카드와 시트가 같이 쓴다. 막대는 방문자 기준이고
        // 기준값(max)을 밖에서 받는다 — 시트가 페이지를 더 받아도 눈금이 안 흔들린다.
        function rankRow(rank, r, max, named) {
          var w = max > 0 ? Math.max(2, Math.round((Number(r.visitors || 0) / max) * 100)) : 0;
          return '<li>' +
            '<div class="rl">' +
              '<span class="rk">' + rank + '</span>' +
              '<span class="lb">' + label(r.label, named) + '</span>' +
              '<span class="vt">' + num(r.visitors) + '<i>명</i></span>' +
              '<span class="vw">' + num(r.views) + '뷰</span>' +
            '</div>' +
            '<div class="rbar"><i style="width:' + w + '%"></i></div>' +
          '</li>';
        }

        function maxVisitors(rows) {
          return rows.reduce(function (m, r) { return Math.max(m, Number(r.visitors || 0)); }, 0);
        }

        function drawRank(el, rows, empty, named) {
          if (!rows.length) {
            el.innerHTML = '<li class="none">' + empty + '</li>';
            return;
          }
          var max = maxVisitors(rows);
          el.innerHTML = rows.map(function (r, i) {
            return rankRow(i + 1, r, max, named);
          }).join('');
        }

        // --- 전체보기 시트 ------------------------------------------------
        // 요약은 5줄이고 나머지는 여기서 본다. DB가 페이지 단위로 넘겨주므로
        // (`admin_visitor_breakdown_page`) 스크롤이 바닥에 닿을 때만 다음 장을 받는다.
        var sheet = { kind: '', offset: 0, total: null, max: null, busy: false };

        function sheetDone() {
          return sheet.total !== null && sheet.offset >= sheet.total;
        }

        function sheetPage() {
          if (sheet.busy || sheetDone()) return Promise.resolve();
          sheet.busy = true;
          $('sfoot').textContent = '불러오는 중';
          return validSession().then(function (session) {
            return rpc(session, 'admin_visitor_breakdown_page', {
              p_kind: sheet.kind,
              p_since_days: 7,
              p_limit: SHEET_PAGE,
              p_offset: sheet.offset,
            });
          }).then(function (rows) {
            rows = rows || [];
            if (rows.length) sheet.total = Number(rows[0].total_rows || 0);
            else if (sheet.total === null) sheet.total = 0;

            // 막대 눈금은 첫 장의 1위로 고정한다. 장마다 다시 재면 이미 그린
            // 행의 길이가 뒤에서 바뀌어 보인다.
            if (sheet.max === null) sheet.max = maxVisitors(rows);
            var named = sheet.kind === 'path';
            var html = rows.map(function (r, i) {
              return rankRow(sheet.offset + i + 1, r, sheet.max, named);
            }).join('');
            $('srows').insertAdjacentHTML('beforeend', html);
            sheet.offset += rows.length;

            if (!sheet.total) $('sfoot').textContent = '아직 기록 없음';
            else if (sheetDone()) $('sfoot').textContent = '전체 ' + num(sheet.total) + '개';
            else $('sfoot').textContent = num(sheet.offset) + ' / ' + num(sheet.total);
          }).catch(function () {
            $('sfoot').textContent = '불러오지 못했습니다.';
          }).then(function () {
            sheet.busy = false;
            // 첫 장이 짧아 스크롤이 안 생기면 바닥 감지가 영영 안 걸린다.
            if (!sheetDone() && $('sbody').scrollHeight <= $('sbody').clientHeight) {
              return sheetPage();
            }
          });
        }

        function openSheet(kind, title) {
          sheet = { kind: kind, offset: 0, total: null, max: null, busy: false };
          $('stitle').textContent = title;
          $('srows').innerHTML = '';
          $('sfoot').textContent = '불러오는 중';
          $('sbody').scrollTop = 0;
          $('sheet').showModal();
          sheetPage();
        }

        $('all-paths').addEventListener('click', function () {
          openSheet('path', '인기 경로 (7일)');
        });
        $('all-refs').addEventListener('click', function () {
          openSheet('referrer', '유입 경로 (7일)');
        });
        $('sclose').addEventListener('click', function () { $('sheet').close(); });
        // 바깥을 누르면 닫는다. dialog는 backdrop 클릭도 자기 자신으로 잡힌다.
        $('sheet').addEventListener('click', function (e) {
          if (e.target === $('sheet')) $('sheet').close();
        });
        $('sbody').addEventListener('scroll', function () {
          var el = $('sbody');
          if (el.scrollTop + el.clientHeight >= el.scrollHeight - 80) sheetPage();
        });

        function render(out) {
          var s = (out[0] || [])[0] || {};
          var daily = out[1] || [];
          var mix = out[2] || [];

          $('gate').hidden = true;
          $('board').hidden = false;
          $('logout').hidden = false;
          $('v-live').textContent = num(s.concurrent_visitors);
          $('v-today').textContent = num(s.today_visitors);
          $('v-todayviews').textContent = num(s.today_views);
          $('v-total').textContent = num(s.total_visitors);
          $('v-totalviews').textContent = num(s.total_views);
          $('v-per').textContent = s.total_visitors
            ? (s.total_views / s.total_visitors).toFixed(1)
            : '-';
          // since_at 아래는 봇 필터가 없던 구간이라 통계에서 끊었다 (0008).
          // 기록이 없을 때 "0"이 트래픽 탓인지 그 절단 탓인지 구분해 준다.
          // Supabase는 timestamptz를 UTC ISO로 내려준다. '2026-09-08 00:00+09'가
          // '2026-09-07T15:00:00+00:00'으로 오므로 앞 10자를 자르면 하루 앞선다.
          // KST로 바꿔 날짜만 뽑는다.
          var kstDate = function (iso) {
            return new Date(iso).toLocaleDateString('sv-SE', { timeZone: 'Asia/Seoul' });
          };
          $('v-since').textContent = s.first_view_at
            ? '수집 시작 ' + kstDate(s.first_view_at) + ' (봇 제외)'
            : (s.since_at ? kstDate(s.since_at) + '부터 집계 (봇 제외)'
                          : '아직 기록 없음');

          drawChart(daily);
          var paths = mix.filter(function (r) { return r.kind === 'path'; });
          var refs = mix.filter(function (r) { return r.kind === 'referrer'; });
          drawRank($('paths'), paths.slice(0, TOP_N), '아직 기록 없음', true);
          // 유입 경로는 호스트명이라 이름표를 붙이지 않는다.
          drawRank($('refs'), refs.slice(0, TOP_N), '아직 기록 없음', false);
          // 요약이 꽉 찼을 때만 전체보기를 연다. 5줄이 다면 시트에 새로 나올 게 없다.
          $('all-paths').hidden = paths.length <= TOP_N;
          $('all-refs').hidden = refs.length <= TOP_N;

          $('updated').textContent =
            new Date().toLocaleTimeString('ko-KR', { hour: '2-digit', minute: '2-digit' }) + ' 기준';
          $('lede').textContent = '방문자 현황을 1분마다 새로 불러옵니다.';
        }

        function stopTimer() {
          if (timer) { clearInterval(timer); timer = null; }
        }

        function load() {
          return validSession().then(function (session) {
            return Promise.all([
              rpc(session, 'admin_visitor_stats'),
              rpc(session, 'admin_visitor_daily', { p_days: 14 }),
              rpc(session, 'admin_visitor_breakdown', { p_since_days: 7 }),
            ]).then(render);
          }).catch(function (err) {
            stopTimer();
            // 로그인은 됐는데 명단에 없는 계정이면 RPC 쪽에서 끊긴다.
            // 세션 문제와 권한 문제는 안내가 달라야 한다.
            if (String(err.message).indexOf('rpc-') === 0) {
              showGate('이 계정은 관리자로 등록돼 있지 않습니다.');
            } else if (err.status || err.message === 'no-session') {
              // 서버가 갱신 토큰을 거절했을 때만 세션을 버린다.
              clearSession();
              showGate('');
            } else {
              // 노트북을 덮었다 열거나 와이파이가 잠깐 끊긴 것이다. 전에는 이것도
              // 세션을 지워서 매번 다시 로그인해야 했다. 세션은 두고 다음 주기에 다시 묻는다.
              if (!$('board').hidden) {
                $('lede').textContent = '연결이 잠깐 끊겼습니다. 1분 뒤 다시 불러옵니다.';
                start();
              } else {
                showGate('서버에 닿지 못했습니다. 연결을 확인하고 새로고침해 주세요.');
              }
            }
          });
        }

        function start() {
          if (!timer) timer = setInterval(load, REFRESH_MS);
        }

        $('loginform').addEventListener('submit', function (e) {
          e.preventDefault();
          var email = $('email').value.trim();
          var password = $('password').value;
          if (!email || !password) {
            note(!email ? '이메일을 입력해 주세요.' : '비밀번호를 입력해 주세요.', true);
            $(!email ? 'email' : 'password').focus();
            return;
          }

          $('submit').disabled = true;
          note('로그인 중...', false);
          auth('token?grant_type=password', { email: email, password: password })
            .then(function (session) {
              saveSession(session);
              try { localStorage.setItem(EMAIL_STORE, email); } catch (e) {}
              // 비밀번호 칸을 여기서 비우면 브라우저가 저장할 값이 사라져 저장
              // 제안이 안 떴다. 크롬, 엣지는 저장을 직접 청하고, 나머지는 폼이
              // 사라지는 것을 보고 제안한다. 칸은 로그아웃 때 비운다.
              if (window.PasswordCredential && navigator.credentials) {
                try {
                  navigator.credentials.store(new PasswordCredential({ id: email, password: password }))
                    .catch(function () {});
                } catch (e) {}
              }
              note('', false);
              return load().then(start);
            })
            .catch(function (err) {
              note(err && err.status
                ? '이메일 또는 비밀번호가 맞지 않습니다.'
                : '서버에 닿지 못했습니다. 연결을 확인하고 다시 눌러 주세요.', true);
            })
            .then(function () { $('submit').disabled = false; });
        });

        $('logout').addEventListener('click', function () {
          var s = loadSession();
          if (s) {
            fetch(origin + '/auth/v1/logout', {
              method: 'POST',
              headers: { apikey: key, Authorization: 'Bearer ' + s.access_token },
            }).catch(function () {});
          }
          clearSession();
          stopTimer();
          $('password').value = '';
          showGate('');
        });

        try { $('email').value = localStorage.getItem(EMAIL_STORE) || ''; } catch (e) {}

        // --- 못 찾은 검색 --------------------------------------------------
        // scripts/search_log_candidates.py와 같은 일을 한다. 같은 방문자가 3분 안에
        // 친 앞토막('캣', '캣타')을 뒤의 긴 말에 접고, 지금 어휘에 걸리는 말은 뺀다.
        var FOLD_SEC = 180;
        var normTerm = function (t) { return String(t).replace(/\s+/g, '').toLowerCase(); };
        var missRows = null;
        var showJudged = false;

        function foldPrefixes(rows) {
          var drop = {};
          var byVisitor = {};
          rows.forEach(function (r, i) {
            var v = r.visitor_id || ('anon' + i);
            (byVisitor[v] = byVisitor[v] || []).push(i);
          });
          Object.keys(byVisitor).forEach(function (v) {
            var seq = byVisitor[v];
            for (var a = 0; a < seq.length; a++) {
              var ra = rows[seq[a]];
              for (var b = a + 1; b < seq.length; b++) {
                var rb = rows[seq[b]];
                if ((new Date(rb.created_at) - new Date(ra.created_at)) / 1000 > FOLD_SEC) break;
                if (rb.term !== ra.term && rb.term.indexOf(ra.term) === 0) { drop[seq[a]] = true; break; }
              }
            }
          });
          return rows.filter(function (r, i) { return !drop[i]; });
        }

        // 검색은 품목명이나 별칭이 검색어를 품을 때 건다. 그러면 지금은 걸린다.
        function coveredBy(t) {
          for (var i = 0; i < vocab.length; i++) if (vocab[i][0].indexOf(t) !== -1) return vocab[i][1];
          return null;
        }
        // 반대로 검색어가 품목명을 품는 경우('향수베이스')는 검색이 안 건다.
        // 후보로 남기되 어느 페이지 이웃인지 적어 준다.
        function nearBy(t) {
          var best = null;
          for (var i = 0; i < vocab.length; i++) {
            var k = vocab[i][0];
            if (k.length >= 2 && t.indexOf(k) !== -1 && (!best || k.length > best[0].length)) best = vocab[i];
          }
          return best && best[1];
        }

        function attr(s) {
          return esc(s).replace(/"/g, '&quot;');
        }

        function drawMisses() {
          var agg = {};
          var covered = 0;
          foldPrefixes(missRows).forEach(function (r) {
            var a = agg[r.term] || (agg[r.term] = { term: r.term, n: 0, vis: {}, last: r.created_at, decision: r.decision });
            a.n += 1;
            a.vis[r.visitor_id || r.created_at] = 1;
            if (r.created_at > a.last) a.last = r.created_at;
          });
          var list = Object.keys(agg).map(function (k) { return agg[k]; }).filter(function (a) {
            if (coveredBy(normTerm(a.term))) { covered++; return false; }
            return true;
          });
          var judged = list.filter(function (a) { return a.decision; }).length;
          if (!showJudged) list = list.filter(function (a) { return !a.decision; });
          // 사람 수가 먼저다. 한 사람이 표기를 바꿔 여러 번 친 것보다 여러 사람이 친 것이 굵다.
          list.sort(function (x, y) {
            return Object.keys(y.vis).length - Object.keys(x.vis).length || y.n - x.n || (y.last > x.last ? 1 : -1);
          });

          $('miss-lede').textContent = '후보 ' + num(list.length) + '개' +
            (showJudged ? '' : ', 판정해 둔 ' + num(judged) + '개 숨김') +
            ', 지금은 검색에 걸리는 ' + num(covered) + '개 제외';
          $('miss-judged').hidden = !judged;
          $('miss-judged').textContent = showJudged ? '판정한 것 숨기기' : '판정한 것도 보기';
          var el = $('misses');
          el.hidden = false;
          if (!list.length) {
            el.innerHTML = '<li class="none">새 후보가 없습니다.</li>';
            return;
          }
          el.innerHTML = list.map(function (a) {
            var near = nearBy(normTerm(a.term));
            var day = new Date(a.last).toLocaleDateString('sv-SE', { timeZone: 'Asia/Seoul' }).slice(5);
            var t = attr(a.term);
            return '<li>' +
              '<span class="mt">' + esc(a.term) + '</span>' +
              '<span class="mn">' + num(a.n) + '회, ' + num(Object.keys(a.vis).length) + '명, ' + day + '</span>' +
              (a.decision ? '<span class="md">' + esc(a.decision) + '</span>' : '') +
              '<span class="ma">' +
                (a.decision
                  ? '<button type="button" class="linkbtn" data-term="' + t + '" data-d="">되돌리기</button>'
                  : '<button type="button" class="linkbtn" data-term="' + t + '" data-d="보류">보류</button>' +
                    '<button type="button" class="linkbtn" data-term="' + t + '" data-d="노이즈">노이즈</button>') +
              '</span>' +
              (near ? '<span class="mh">' + esc(near) + ' 페이지가 있는데 이 말로는 안 걸립니다. 별칭 후보</span>' : '') +
            '</li>';
          }).join('');
        }

        function loadMisses() {
          $('miss-load').disabled = true;
          $('miss-lede').textContent = '불러오는 중';
          return validSession().then(function (session) {
            return rpc(session, 'admin_search_misses', { p_days: 90 });
          }).then(function (rows) {
            missRows = rows || [];
            drawMisses();
          }).catch(function () {
            $('miss-lede').textContent = '불러오지 못했습니다. 다시 눌러 주세요.';
          }).then(function () {
            $('miss-load').disabled = false;
            $('miss-load').textContent = '다시 불러오기';
          });
        }

        $('miss-load').addEventListener('click', loadMisses);
        $('miss-judged').addEventListener('click', function () {
          showJudged = !showJudged;
          if (missRows) drawMisses();
        });
        $('misses').addEventListener('click', function (e) {
          var btn = e.target.closest('button[data-term]');
          if (!btn) return;
          var term = btn.getAttribute('data-term');
          var d = btn.getAttribute('data-d') || null;
          btn.disabled = true;
          validSession().then(function (session) {
            return rpc(session, 'admin_set_search_decision', { p_term: term, p_decision: d });
          }).then(function () {
            missRows.forEach(function (r) { if (r.term === term) r.decision = d; });
            drawMisses();
          }).catch(function () {
            btn.disabled = false;
            $('miss-lede').textContent = '저장하지 못했습니다. 다시 눌러 주세요.';
          });
        });

        if (loadSession()) {
          load().then(start);
        } else {
          showGate('');
        }
      })();
    </script>
  )}
</Base>
