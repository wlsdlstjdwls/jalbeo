---
/** 근거 출처. CLAUDE.md 규칙 — 출처 URL과 기준일자를 반드시 함께 표시한다. */
interface Props {
  sources: { title: string; url: string; asOf: string }[];
  updated: string;
}
const { sources, updated } = Astro.props;
---

<section class="sources">
  <h2>근거</h2>
  <ol>
    {sources.map((s) => (
      <li>
        <a href={s.url} rel="nofollow noopener" target="_blank">{s.title}</a>
        <span class="asof">기준일 {s.asOf}</span>
      </li>
    ))}
  </ol>
  <p class="updated">이 페이지 최종 확인 {updated}</p>
</section>

<style>
  .sources { margin-top: 2.4rem; }
  .sources h2 {
    font-size: 1.16rem;
    margin: 0 0 .6rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }
  .sources ol {
    padding-left: 1.15rem;
    margin: .4rem 0;
    font-size: .92rem;
  }
  .sources li { margin: .4rem 0; }
  .asof {
    display: inline-block;
    color: var(--muted);
    font-size: .78rem;
    margin-left: .45rem;
  }
  .updated { color: var(--muted); font-size: .8rem; margin-top: .8rem; }
</style>
