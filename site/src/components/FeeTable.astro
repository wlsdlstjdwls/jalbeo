---
/**
 * 대형폐기물 수수료. 두 가지를 숨기지 않는다 (docs/12, docs/26).
 * 1. 지자체마다 몇 배씩 다르다 → 중앙값 + 범위
 * 2. 과금 단위가 갈린다 → 장롱은 다수가 '1쪽당'이라 통짜와 섞으면 3배 틀린다.
 *    면적(㎡), 길이(m), 무게(kg)로 매기는 품목도 같은 이유로 따로 낸다
 */
import { UNIT_LABEL, type FeeStat, type FeeUnit, type FeeUnitName } from '../lib/fees';

interface Props {
  name: string;
  stat: FeeStat;
}
const { name, stat } = Astro.props;

// CLAUDE.md 규칙 — 수수료 데이터는 출처 URL과 기준일자를 함께 표시한다.
const SOURCE_URL =
  'https://www.data.go.kr/tcs/dss/selectDataSetList.do?dType=FILE&keyword=%EB%8C%80%ED%98%95%ED%8F%90%EA%B8%B0%EB%AC%BC+%EC%88%98%EC%88%98%EB%A3%8C';

const won = (n: number) => n.toLocaleString('ko-KR');

const main: FeeUnit = stat.units[0].stat;
const mainName: FeeUnitName = stat.units[0].name;
const others = stat.units.slice(1);
const measured = mainName !== 'whole';

// 단위당 요금은 하나만 보면 감이 안 온다. 흔한 크기로 곱해 보여준다.
const EXAMPLE: Partial<Record<FeeUnitName, { times: number; how: string }>> = {
  panel: { times: 3, how: '3쪽짜리 NAME이라면' },
  area: { times: 3.3, how: '3.3㎡(1평)면' },
  length: { times: 5, how: '5m면' },
  weight: { times: 10, how: '10kg이면' },
};
const example = EXAMPLE[mainName];
const totalRegions = stat.units.reduce((n, u) => n + u.stat.regions, 0);

const thin = main.regions < 10;
const spread = main.max >= main.min * 2;
const pos = (v: number) =>
  main.max === main.min ? 50 : ((v - main.min) / (main.max - main.min)) * 100;
---

<div class="fees" id="fees">
  <p class="caption divider">수수료</p>

  <div class="lead">
    <span class="big">{won(main.median)}원</span>
    <span class="unit">{UNIT_LABEL[mainName]}</span>
  </div>

  {measured && example ? (
    <p class="sub unitwarn">
      <strong>{UNIT_LABEL[mainName].replace('당', '')}마다 부과됩니다.</strong>
      {example.how.replace('NAME', name)} {won(Math.round(main.median * example.times))}원입니다.
      요금을 공개한 {totalRegions}곳 중 {main.regions}곳이 이 방식입니다.
    </p>
  ) : (
    <p class="sub">
      {main.regions}개 지자체 공개 요금의 중앙값입니다.
      {thin && <strong>표본이 적어 참고용입니다.</strong>}
    </p>
  )}

  <div class="bar" aria-hidden="true">
    <span class="fill" style={`left:${pos(main.q1)}%;right:${100 - pos(main.q3)}%`}></span>
    <span class="tick" style={`left:${pos(main.median)}%`}></span>
  </div>
  <div class="ends">
    <span>{won(main.min)}원<em>{main.cheapest.region}</em></span>
    <span class="r">{won(main.max)}원<em>{main.dearest.region}</em></span>
  </div>

  {spread && (
    <p class="warn">
      같은 {name}인데 지역에 따라 {Math.round(main.max / main.min)}배까지 차이 납니다.
      배출 전에 거주지 기준을 확인하세요.
    </p>
  )}

  {others.map((o) => (
    <p class="alt">
      {o.stat.regions}곳은 {o.name === 'whole'
        ? '단위와 무관하게 한 번만'
        : `${UNIT_LABEL[o.name]}으로`} 부과하며
      중앙값 {won(o.stat.median)}원입니다.
    </p>
  ))}

  <details class="more">
    <summary>지역별 수수료 보기</summary>
    <table>
      <thead>
        <tr>
          <th>지역</th>
          <th>{measured ? UNIT_LABEL[mainName] : '수수료'}</th>
        </tr>
      </thead>
      <tbody>
        {Object.entries(main.byRegion).map(([region, fee]) => (
          <tr><td>{region}</td><td>{won(fee)}원</td></tr>
        ))}
      </tbody>
    </table>

    {others.map((o) => (
      <>
        <p class="othercap">
          {o.name === 'whole' ? '한 번만 부과하는 지역' : `${UNIT_LABEL[o.name]} 부과하는 지역`}
        </p>
        <table>
          <tbody>
            {Object.entries(o.stat.byRegion).map(([region, fee]) => (
              <tr><td>{region}</td><td>{won(fee)}원</td></tr>
            ))}
          </tbody>
        </table>
      </>
    ))}

    <p class="note">
      <a href={SOURCE_URL} rel="nofollow noopener" target="_blank">공공데이터포털</a>
      공개분만 집계했습니다. 목록에 없는 지자체는 해당 시군구 홈페이지에서
      확인하세요. 기준일 {stat.baseDate || '데이터셋별 상이'}.
    </p>
  </details>
</div>

<style>
  .lead { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .big {
    font-weight: 800;
    font-size: clamp(34px, 5.6vw, 60px);
    letter-spacing: -.05em;
    line-height: 1;
    background: var(--lime);
    padding: 2px 10px;
  }
  .unit { font-size: 17px; font-weight: 800; }
  .sub { margin: 12px 0 0; font-size: 14.5px; line-height: 1.65; color: var(--muted); }
  .sub strong { font-weight: 800; color: var(--ink); }
  .unitwarn {
    border-left: 6px solid var(--ink);
    padding: 10px 0 10px 12px;
    color: var(--body);
  }

  .bar {
    position: relative;
    height: 14px;
    margin: 20px 0 0;
    border: 2px solid var(--ink);
    background: var(--card);
  }
  .fill { position: absolute; top: 0; bottom: 0; background: var(--lime); }
  .tick { position: absolute; top: -5px; bottom: -5px; width: 4px; background: var(--ink); }

  .ends {
    display: flex;
    justify-content: space-between;
    margin-top: 8px;
    font-size: 13px;
    font-weight: 800;
  }
  .ends .r { text-align: right; }
  .ends em {
    display: block;
    font-style: normal;
    font-size: 12px;
    font-weight: 700;
    color: var(--faint);
  }

  .warn {
    margin: 16px 0 0;
    border-left: 6px solid var(--ink);
    padding: 10px 0 10px 12px;
    font-size: 14.5px;
    line-height: 1.65;
    font-weight: 600;
  }
  .alt { margin: 14px 0 0; font-size: 13.5px; line-height: 1.6; color: var(--faint); }

  .more { margin: 18px 0 0; }
  summary {
    cursor: pointer;
    display: inline-block;
    border: 2px solid var(--ink);
    background: var(--card);
    padding: 10px 16px;
    font-size: 14px;
    font-weight: 800;
  }
  summary:hover { background: var(--lime); }
  .more table {
    width: 100%;
    margin: 14px 0 0;
    border: 2px solid var(--ink);
    border-collapse: collapse;
    background: var(--card);
  }
  .more th, .more td {
    border-bottom: 1px solid var(--line);
    padding: 10px 13px;
    text-align: left;
  }
  .more th {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .06em;
    color: var(--faint);
    border-bottom: 2px solid var(--ink);
  }
  .more td { font-size: 14px; }
  .more td:last-child { font-weight: 800; text-align: right; }
  .more tr:last-child td { border-bottom: 0; }
  .othercap { margin: 22px 0 0; font-size: 13px; font-weight: 800; }
  .note { margin: 12px 0 0; font-size: 12.5px; line-height: 1.6; color: var(--faint); }
  .note a { box-shadow: inset 0 -2px 0 var(--lime); font-weight: 700; }
</style>
