---
/**
 * 대형폐기물 수수료. 두 가지를 숨기지 않는다 (docs/12, docs/26).
 * 1. 지자체마다 몇 배씩 다르다 → 중앙값 + 범위
 * 2. 과금 단위가 갈린다 → 장롱은 다수가 '1쪽당'이라 통짜와 섞으면 3배 틀린다.
 *    면적(㎡), 길이(m), 무게(kg)로 매기는 품목도 같은 이유로 따로 낸다
 */
import feesMeta from '../data/fees_meta.json';
import { UNIT_LABEL, ALL_REGIONS, type FeeStat, type FeeUnit, type FeeUnitName } from '../lib/fees';

interface Props {
  name: string;
  stat: FeeStat;
}
const { name, stat } = Astro.props;

// CLAUDE.md 규칙 — 수수료 데이터는 출처 URL과 기준일자를 함께 표시한다.
const SOURCE_URL =
  'https://www.data.go.kr/tcs/dss/selectDataSetList.do?dType=FILE&keyword=%EB%8C%80%ED%98%95%ED%8F%90%EA%B8%B0%EB%AC%BC+%EC%88%98%EC%88%98%EB%A3%8C';

const won = (n: number) => n.toLocaleString('ko-KR');

const main: FeeUnit = stat.units[0].stat;
const mainName: FeeUnitName = stat.units[0].name;
const others = stat.units.slice(1);
const measured = mainName !== 'whole';

// 단위당 요금은 하나만 보면 감이 안 온다. 흔한 크기로 곱해 보여준다.
const EXAMPLE: Partial<Record<FeeUnitName, { times: number; how: string }>> = {
  panel: { times: 3, how: '3쪽짜리 NAME이라면' },
  area: { times: 3.3, how: '3.3㎡(1평)면' },
  length: { times: 5, how: '5m면' },
  weight: { times: 10, how: '10kg이면' },
  // 부피는 100ℓ 마대가 기본 단위다. 지자체가 그렇게 적어 놨다.
  volume: { times: 100, how: '100ℓ 마대 한 개면' },
};
const example = EXAMPLE[mainName];
const totalRegions = stat.units.reduce((n, u) => n + u.stat.regions, 0);

const thin = main.regions < 10;
const spread = main.max >= main.min * 2;
const pos = (v: number) =>
  main.max === main.min ? 50 : ((v - main.min) / (main.max - main.min)) * 100;

// 지역 선택. 표는 그대로 두고, 고른 지역이 있으면 클라이언트에서 리드 숫자만 바꿔친다
// (지역 선택기 방침 - 판단 2, 페이지를 곱하지 않고 페이지 내부에서 처리).
// 지역명은 48개 시군구 전체 공통(lib/fees.ts ALL_REGIONS)이라 이 품목에 데이터가
// 없는 지역을 골라도 선택지에는 뜬다 - 그 경우는 스크립트가 "데이터 없음"으로 답한다.
const regionLookup: Record<string, { fee: number; unit: FeeUnitName }> = {};
for (const u of stat.units) {
  for (const [region, fee] of Object.entries(u.stat.byRegion)) {
    regionLookup[region] = { fee, unit: u.name };
  }
}
const clientData = { unitLabel: UNIT_LABEL, lookup: regionLookup };
---

<div class="fees" id="fees">
  <p class="caption divider">수수료</p>

  <div class="regionpick">
    <label for="region-input" class="rp-label">우리 동네 기준으로 보기</label>
    <div class="rp-box">
      <input
        type="text"
        id="region-input"
        class="rp-input"
        placeholder="지역 검색 (예: 강남구)"
        autocomplete="off"
        role="combobox"
        aria-expanded="false"
        aria-controls="region-list"
        aria-autocomplete="list"
      />
      <button type="button" class="rp-clear" id="region-clear" hidden aria-label="지역 선택 해제">×</button>
    </div>
    <ul class="rp-list" id="region-list" role="listbox" hidden>
      <li role="option" data-value="" class="rp-opt rp-all" aria-selected="true">전체(중앙값)</li>
      {ALL_REGIONS.map((r) => <li role="option" data-value={r} class="rp-opt" aria-selected="false">{r}</li>)}
      <li class="rp-empty" hidden>일치하는 지역이 없습니다</li>
    </ul>
  </div>

  <div class="lead">
    <span class="big">{won(main.median)}원</span>
    <span class="unit">{UNIT_LABEL[mainName]}</span>
  </div>

  {measured && example ? (
    <p class="sub unitwarn">
      <strong>{UNIT_LABEL[mainName].replace('당', '')}마다 부과됩니다.</strong>
      {example.how.replace('NAME', name)} {won(Math.round(main.median * example.times))}원입니다.
      요금을 공개한 {totalRegions}곳 중 {main.regions}곳이 이 방식입니다.
    </p>
  ) : (
    <p class="sub">
      {main.regions}개 지자체 공개 요금의 중앙값입니다.
      {thin && <strong>표본이 적어 참고용입니다.</strong>}
    </p>
  )}

  <div class="bar" aria-hidden="true">
    <span class="fill" style={`left:${pos(main.q1)}%;right:${100 - pos(main.q3)}%`}></span>
    <span class="tick" style={`left:${pos(main.median)}%`}></span>
  </div>
  <div class="ends">
    <span>{won(main.min)}원<em>{main.cheapest.region}</em></span>
    <span class="r">{won(main.max)}원<em>{main.dearest.region}</em></span>
  </div>

  {spread && (
    <p class="warn">
      같은 {name}인데 지역에 따라 {Math.round(main.max / main.min)}배까지 차이 납니다.
      배출 전에 거주지 기준을 확인하세요.
    </p>
  )}

  {others.map((o) => (
    <p class="alt">
      {o.stat.regions}곳은 {o.name === 'whole'
        ? '단위와 무관하게 한 번만'
        : `${UNIT_LABEL[o.name]}으로`} 부과하며
      중앙값 {won(o.stat.median)}원입니다.
    </p>
  ))}

  <details class="more">
    <summary>지역별 수수료 보기</summary>
    <table>
      <thead>
        <tr>
          <th>지역</th>
          <th>{measured ? UNIT_LABEL[mainName] : '수수료'}</th>
        </tr>
      </thead>
      <tbody>
        {Object.entries(main.byRegion).map(([region, fee]) => (
          <tr data-region={region}><td>{region}</td><td>{won(fee)}원</td></tr>
        ))}
      </tbody>
    </table>

    {others.map((o) => (
      <>
        <p class="othercap">
          {o.name === 'whole' ? '한 번만 부과하는 지역' : `${UNIT_LABEL[o.name]} 부과하는 지역`}
        </p>
        <table>
          <tbody>
            {Object.entries(o.stat.byRegion).map(([region, fee]) => (
              <tr data-region={region}><td>{region}</td><td>{won(fee)}원</td></tr>
            ))}
          </tbody>
        </table>
      </>
    ))}

    <p class="note">
      <a href={SOURCE_URL} rel="nofollow noopener" target="_blank">공공데이터포털</a>
      공개분만 집계했습니다. 목록에 없는 지자체는 해당 시군구 홈페이지에서
      확인하세요. 자료 기준일 {stat.baseDate || '데이터셋별 상이'}, 마지막으로 받은 날 {feesMeta.collected_at}.
    </p>
  </details>

  <script type="application/json" id="fees-region-data" set:html={JSON.stringify(clientData)}></script>
</div>

<script>
  // 지역 선택 복원 + 반영. 표는 그대로 두고 리드 숫자만 바꿔친다.
  // 선택은 사이트 전체에서 공유되는 localStorage 값이라 다른 품목 페이지로
  // 옮겨가도 같은 지역이 유지된다 (품목마다 그 지역 데이터가 없을 수도 있다).
  function initFeeRegionPicker(root: HTMLElement) {
    const dataEl = root.querySelector<HTMLScriptElement>('#fees-region-data');
    const input = root.querySelector<HTMLInputElement>('.rp-input');
    const clearBtn = root.querySelector<HTMLButtonElement>('.rp-clear');
    const list = root.querySelector<HTMLUListElement>('.rp-list');
    const emptyLi = root.querySelector<HTMLLIElement>('.rp-empty');
    const big = root.querySelector<HTMLElement>('.big');
    const unit = root.querySelector<HTMLElement>('.unit');
    const sub = root.querySelector<HTMLElement>('.sub');
    if (!dataEl || !input || !clearBtn || !list || !emptyLi || !big || !unit || !sub) return;

    const data: { unitLabel: Record<string, string>; lookup: Record<string, { fee: number; unit: string }> } =
      JSON.parse(dataEl.textContent || '{}');
    const rows = root.querySelectorAll<HTMLTableRowElement>('[data-region]');
    const opts = Array.from(list.querySelectorAll<HTMLLIElement>('[data-value]'));
    const STORE_KEY = 'jalbeo_region';

    // 서버가 렌더한 기본(중앙값) 화면을 저장해 뒀다가 "전체"로 되돌릴 때 복원한다.
    const original = { big: big.textContent, unit: unit.textContent, subHTML: sub.innerHTML };
    const fmt = (n: number) => n.toLocaleString('ko-KR');
    let selected = '';

    function apply(region: string) {
      rows.forEach((tr) => tr.classList.toggle('me', tr.dataset.region === region));

      if (!region) {
        big.textContent = original.big;
        unit.textContent = original.unit;
        sub.innerHTML = original.subHTML;
        return;
      }

      const hit = data.lookup[region];
      if (!hit) {
        big.textContent = original.big;
        unit.textContent = original.unit;
        sub.textContent = `${region} 공개 데이터가 없어 전체 중앙값을 대신 보여줍니다.`;
        return;
      }

      big.textContent = `${fmt(hit.fee)}원`;
      unit.textContent = data.unitLabel[hit.unit] ?? '';
      sub.textContent = `${region} 기준 수수료입니다.`;
    }

    function closeList() {
      list.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      opts.forEach((li) => li.classList.remove('active'));
    }

    function openList() {
      list.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    }

    // 입력값과 지역명을 그대로 부분일치시킨다 - 47개뿐이라 자모 편집거리
    // 같은 관용은 필요 없다(판단 33, 36은 검색량/씨앗용이지 이 목록용이 아니다).
    function filterList(query: string) {
      const q = query.trim();
      let any = false;
      opts.forEach((li) => {
        const value = li.dataset.value ?? '';
        const match = !q || value.indexOf(q) !== -1;
        li.hidden = !match;
        if (match) any = true;
      });
      emptyLi.hidden = any;
    }

    function select(region: string) {
      selected = region;
      input.value = region;
      clearBtn.hidden = !region;
      opts.forEach((li) => li.setAttribute('aria-selected', li.dataset.value === region ? 'true' : 'false'));
      closeList();
      try {
        if (region) localStorage.setItem(STORE_KEY, region);
        else localStorage.removeItem(STORE_KEY);
      } catch {
        /* 저장 실패해도 화면 반영은 그대로 한다 */
      }
      apply(region);
    }

    input.addEventListener('focus', () => {
      filterList(input.value === selected ? '' : input.value);
      openList();
    });

    input.addEventListener('input', () => {
      filterList(input.value);
      openList();
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        input.value = selected;
        closeList();
        return;
      }
      const visible = opts.filter((li) => !li.hidden);
      if (e.key === 'Enter') {
        e.preventDefault();
        const active = visible.find((li) => li.classList.contains('active')) ?? (visible.length === 1 ? visible[0] : null);
        if (active) select(active.dataset.value ?? '');
        return;
      }
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (list.hidden) { filterList(''); openList(); return; }
        if (!visible.length) return;
        const idx = visible.findIndex((li) => li.classList.contains('active'));
        const next = e.key === 'ArrowDown'
          ? visible[Math.min(idx + 1, visible.length - 1)]
          : visible[Math.max(idx - 1, 0)];
        visible.forEach((li) => li.classList.remove('active'));
        next.classList.add('active');
        next.scrollIntoView({ block: 'nearest' });
      }
    });

    // blur보다 먼저 눌러 리스트 클릭이 씹히지 않게 한다 (포커스가 안 빠진다).
    list.addEventListener('mousedown', (e) => e.preventDefault());
    clearBtn.addEventListener('mousedown', (e) => e.preventDefault());

    list.addEventListener('click', (e) => {
      const li = (e.target as HTMLElement).closest<HTMLLIElement>('[data-value]');
      if (li) select(li.dataset.value ?? '');
    });

    clearBtn.addEventListener('click', () => select(''));

    input.addEventListener('blur', () => {
      input.value = selected;
      closeList();
    });

    try {
      const saved = localStorage.getItem(STORE_KEY);
      if (saved) select(saved);
    } catch {
      /* localStorage 접근 실패 - 기본(중앙값) 화면 그대로 둔다 */
    }
  }

  document.querySelectorAll<HTMLElement>('.fees').forEach(initFeeRegionPicker);
</script>

<style>
  .regionpick { position: relative; margin: 0 0 14px; }
  .rp-label { display: block; margin: 0 0 8px; font-size: 13.5px; font-weight: 800; }
  .rp-box {
    display: flex;
    align-items: stretch;
    border: 2px solid var(--ink);
    background: var(--card);
  }
  .rp-input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    outline: none;
    padding: 10px 12px;
    font-size: 14px;
    font-weight: 700;
  }
  .rp-input::placeholder { color: var(--ph); }
  .rp-clear {
    flex: none;
    width: 36px;
    border: 0;
    border-left: 2px solid var(--ink);
    background: var(--card);
    font-size: 17px;
    font-weight: 800;
    line-height: 1;
    cursor: pointer;
  }
  .rp-clear:hover { background: var(--lime); }
  .rp-list {
    position: absolute;
    z-index: 5;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    max-height: 260px;
    overflow-y: auto;
    border: 2px solid var(--ink);
    background: var(--card);
    box-shadow: 4px 4px 0 var(--ink);
  }
  .rp-opt {
    padding: 9px 12px;
    font-size: 13.5px;
    font-weight: 700;
    cursor: pointer;
    border-bottom: 1px solid var(--line);
  }
  .rp-opt:last-child { border-bottom: 0; }
  .rp-opt:hover, .rp-opt.active { background: var(--lime); }
  .rp-opt.rp-all { color: var(--faint); border-bottom: 2px solid var(--ink); }
  .rp-empty { padding: 9px 12px; font-size: 13px; font-weight: 600; color: var(--faint); }
  .lead { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .big {
    font-weight: 800;
    font-size: clamp(34px, 5.6vw, 60px);
    letter-spacing: -.05em;
    line-height: 1;
    background: var(--lime);
    padding: 2px 10px;
  }
  .unit { font-size: 17px; font-weight: 800; }
  .sub { margin: 12px 0 0; font-size: 14.5px; line-height: 1.65; color: var(--muted); }
  .sub strong { font-weight: 800; color: var(--ink); }
  .unitwarn {
    border-left: 6px solid var(--ink);
    padding: 10px 0 10px 12px;
    color: var(--body);
  }

  .bar {
    position: relative;
    height: 14px;
    margin: 20px 0 0;
    border: 2px solid var(--ink);
    background: var(--card);
  }
  .fill { position: absolute; top: 0; bottom: 0; background: var(--lime); }
  .tick { position: absolute; top: -5px; bottom: -5px; width: 4px; background: var(--ink); }

  .ends {
    display: flex;
    justify-content: space-between;
    margin-top: 8px;
    font-size: 13px;
    font-weight: 800;
  }
  .ends .r { text-align: right; }
  .ends em {
    display: block;
    font-style: normal;
    font-size: 12px;
    font-weight: 700;
    color: var(--faint);
  }

  .warn {
    margin: 16px 0 0;
    border-left: 6px solid var(--ink);
    padding: 10px 0 10px 12px;
    font-size: 14.5px;
    line-height: 1.65;
    font-weight: 600;
  }
  .alt { margin: 14px 0 0; font-size: 13.5px; line-height: 1.6; color: var(--faint); }

  .more { margin: 18px 0 0; }
  summary {
    cursor: pointer;
    display: inline-block;
    border: 2px solid var(--ink);
    background: var(--card);
    padding: 10px 16px;
    font-size: 14px;
    font-weight: 800;
  }
  summary:hover { background: var(--lime); }
  .more table {
    width: 100%;
    margin: 14px 0 0;
    border: 2px solid var(--ink);
    border-collapse: collapse;
    background: var(--card);
  }
  .more th, .more td {
    border-bottom: 1px solid var(--line);
    padding: 10px 13px;
    text-align: left;
  }
  .more th {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .06em;
    color: var(--faint);
    border-bottom: 2px solid var(--ink);
  }
  .more td { font-size: 14px; }
  .more td:last-child { font-weight: 800; text-align: right; }
  .more tr:last-child td { border-bottom: 0; }
  .more tr.me td { background: var(--lime); }
  .othercap { margin: 22px 0 0; font-size: 13px; font-weight: 800; }
  .note { margin: 12px 0 0; font-size: 12.5px; line-height: 1.6; color: var(--faint); }
  .note a { box-shadow: inset 0 -2px 0 var(--lime); font-weight: 700; }
</style>
