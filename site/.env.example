# Supabase — 빌드 때만 읽는다 (scripts/pull-data.mjs). 런타임에는 쓰이지 않는다.
# 값이 없으면 커밋된 JSON 스냅샷으로 빌드한다.
SUPABASE_URL=          # .env.public 에 커밋돼 있음. 덮어쓸 때만 사용
SUPABASE_ANON_KEY=     # 위와 같음

# 배포 도메인. 미설정 시 https://jalbeo.com
SITE_URL=

# 아래는 커밋하지 않는다 (.env). 마이그레이션·대량 임포트 전용.
SUPABASE_DB_HOST=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
